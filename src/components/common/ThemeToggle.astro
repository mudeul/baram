<style>
  .theme-toggle {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-base);
  }

  .theme-toggle:hover {
    background: var(--glass-bg-solid);
  }

  .icon {
    position: absolute;
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
    width: 20px;
    height: 20px;
  }

  .icon-sun,
  .icon-moon {
    opacity: 0;
    transform: scale(0.8) rotate(-180deg);
  }

  .icon-system {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  /* System mode */
  :global([data-theme-mode='system']) .icon-system {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  :global([data-theme-mode='system']) .icon-sun,
  :global([data-theme-mode='system']) .icon-moon {
    opacity: 0;
    transform: scale(0.8) rotate(180deg);
  }

  /* Light mode */
  :global([data-theme-mode='light']) .icon-sun {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  :global([data-theme-mode='light']) .icon-moon,
  :global([data-theme-mode='light']) .icon-system {
    opacity: 0;
    transform: scale(0.8) rotate(180deg);
  }

  /* Dark mode */
  :global([data-theme-mode='dark']) .icon-moon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  :global([data-theme-mode='dark']) .icon-sun,
  :global([data-theme-mode='dark']) .icon-system {
    opacity: 0;
    transform: scale(0.8) rotate(180deg);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon {
      transition: opacity var(--transition-base);
    }
  }
</style>
