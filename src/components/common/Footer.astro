---
import siteConfig from '@/site.config';
import GlassPanel from './GlassPanel.astro';

const currentYear = new Date().getFullYear();

const socialIcons = {
  github: ``,
  twitter: ``,
  linkedin: ``,
  instagram: ``,
  youtube: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><title>YouTube</title><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  bluesky: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><title>Bluesky</title><path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/></svg>`,
};
---

<footer class="site-footer" data-pagefind-ignore>
  <GlassPanel variant="solid" padding="xl" radius="none">
    <div class="container footer-container">
      <!-- Main Footer Content -->
      <div class="footer-grid">
        <!-- Brand Section -->
        <div class="footer-section">
          <h3 class="footer-title">{siteConfig.name}</h3>
          <p class="footer-description">{siteConfig.description}</p>
        </div>

        <!-- Social Links -->
        <div class="footer-section">
          <h4 class="footer-subtitle">Connect</h4>
          <div class="social-links">
            {
              Object.entries(siteConfig.social).map(
                ([platform, url]) =>
                  url && (
                    <a
                      href={url}
                      class="social-link"
                      aria-label={`Follow us on ${platform} (opens in new tab)`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Fragment
                        set:html={
                          socialIcons[platform as keyof typeof socialIcons]
                        }
                      />
                    </a>
                  ),
              )
            }
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="glass-divider"></div>

      <!-- Bottom Bar -->
      <div class="footer-bottom">
        <p class="copyright">
          © {currentYear}
          {siteConfig.name}. All rights reserved.
        </p>
        <p class="credits">
          Built with <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer">Astro</a
          >
          · Theme by {
            siteConfig.social.github ? (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                {siteConfig.author}
              </a>
            ) : (
              siteConfig.author
            )
          }
          · <a
            href="https://almanac.p4ni.com"
            target="_blank"
            rel="noopener noreferrer">Almanac — premium directory theme</a
          >
        </p>
      </div>
    </div>
  </GlassPanel>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-3xl);
  }

  .footer-container {
    max-width: var(--container-max);
    margin: 0 auto;
    container-type: inline-size;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }

  @container (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0;
    background: linear-gradient(
      135deg,
      var(--color-accent),
      var(--color-accent-light)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .footer-title {
      background: none;
      -webkit-text-fill-color: currentColor;
      color: var(--color-text);
    }
  }

  .footer-subtitle {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
    margin-left: 4px; /* 🌟 이 줄을 추가해서 오른쪽으로 살짝 밀어줍니다 (간격이 부족하면 6px 등으로 늘려보세요) */
  }

  .footer-description {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--color-text-muted);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  @media (hover: hover) {
    .social-link:hover {
      background: var(--color-accent-glass);
      color: var(--color-accent);
      transform: translateY(-2px);
    }
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-lg);
  }

  .copyright,
  .credits {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .credits a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .credits a:hover {
    text-decoration: underline;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Focus styles */
  .social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* 🌟 두 번째 소셜 링크(블루스키)의 아이콘 전체 위치를 아래로 살짝 조정 */
  .social-links a:nth-child(2) svg {
    transform: translateY(
      1.5px
    ); /* 필요에 따라 1px ~ 2px 사이로 조절해보세요 */
  }
</style>
