---
import type { ImageMetadata } from 'astro';
import Tag from '@/components/ui/Tag.astro';
import Picture from '@/components/ui/Picture.astro';
import Badge from '@/components/ui/Badge.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  tags?: string[];
  href: string;
  slug: string;
  readingTime?: number;
  featured?: boolean;
  pinned?: boolean; // 🌟 추가
  class?: string;
}

const {
  title,
  description,
  pubDate,
  heroImage,
  heroImageAlt,
  tags = [],
  href,
  slug,
  featured = false,
  pinned = false, // 🌟 추가
  class: className = '',
} = Astro.props;

// 🌟 날짜를 YYYY.MM.DD 형식으로 변환합니다.
const year = pubDate.getFullYear();
const month = String(pubDate.getMonth() + 1).padStart(2, '0');
const day = String(pubDate.getDate()).padStart(2, '0');
const formattedDate = `${year}.${month}.${day}`;
---

<article class:list={['blog-card', 'glass-card', className]}>
  {
    heroImage && (
      <a
        href={href}
        class="blog-card__image-link"
        tabindex="-1"
        aria-hidden="true"
      >
        <div class="blog-card__image" transition:name={`post-image-${slug}`}>
          <Picture
            src={heroImage}
            alt={heroImageAlt ?? title}
            widths={[400, 800]}
            sizes="(min-width: 900px) 400px, 100vw"
          />
          {featured && (
            <span class="blog-card__featured">
              <Badge variant="accent">Featured</Badge>
            </span>
          )}
        </div>
      </a>
    )
  }

  <div class="blog-card__content">
    <header class="blog-card__header">
      <div class="blog-card__meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      </div>
    </header>

    <h3 class="blog-card__title">
      <a href={href}>
        {title}
        {/* 🌟 pinned가 true일 때 SVG 핀 아이콘 표시 */}
        {
          pinned && (
            <span class="pinned-badge" title="Pinned">
              <svg
                class="pinned-icon-svg"
                viewBox="0 0 24 24"
                width="1em"
                height="1em"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="12" y1="17" x2="12" y2="22" />
                <path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-.89 1.79l-1.78.9A2 2 0 0 0 5 15.24Z" />
              </svg>
            </span>
          )
        }
      </a>
    </h3>

    <p class="blog-card__description">{description}</p>

    {
      tags.length > 0 && (
        <div class="blog-card__tags">
          {tags.slice(0, 3).map((tag) => (
            <Tag name={tag} size="sm" />
          ))}
        </div>
      )
    }

    <span class="blog-card__link" aria-hidden="true">Read more →</span>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .blog-card__image-link {
    display: block;
    text-decoration: none;
  }

  .blog-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
    background: var(--glass-bg);
  }

  .blog-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  @media (hover: hover) {
    .blog-card:hover .blog-card__image :global(img) {
      transform: scale(1.05);
    }
  }

  .blog-card__featured {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
  }

  .blog-card__content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card__header {
    margin-bottom: var(--space-md);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .blog-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .blog-card__title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  /* Make the whole card clickable while keeping the title as the real link. */
  .blog-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .blog-card {
    position: relative;
  }

  .blog-card__title a:hover {
    color: var(--color-accent);
  }

  .blog-card__title a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .blog-card__description {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  .blog-card__link {
    display: inline-flex;
    align-items: center;
    color: var(--color-accent-text);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .blog-card__content {
      padding: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card:hover .blog-card__image :global(img) {
      transform: none;
    }
  }

  .pinned-badge {
    display: inline-flex;
    align-items: center;
    margin-left: 0.4rem;
    font-size: 0.9em;
    vertical-align: middle;
    color: var(--color-accent); /* 포인트 컬러(테마 색상) 연동 */
  }

  .pinned-icon-svg {
    /* 필요에 따라 미세한 위치나 회전 조절 가능 */
    transform: rotate(45deg); /* 핀을 대각선으로 예쁘게 꽂힌 모양으로 회전 */
  }
</style>
