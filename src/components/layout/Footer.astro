---
import { themeConfig } from '@/config'
import { createClient } from '@supabase/supabase-js'

const today = new Date()

// 1. 현재 경로가 메인 페이지('/')인지 확인합니다.
const isHome = Astro.url.pathname === '/'

// 2. 서버 측에서 미리 Supabase의 최신 카운트 값을 가져옵니다!
// (클라이언트 키 그대로 써도 서버 측에서 안전하게 조회 가능합니다)
const supabaseUrl = 'https://hdbqwihlntywvgratfrx.supabase.co'
const supabaseKey = 'sb_publishable_H686ApYaPygboh-6GXfoMQ_bHLA4qrq'
const supabase = createClient(supabaseUrl, supabaseKey)

let initialCount = 0

try {
  const { data } = await supabase.from('site_counters').select('count').eq('id', 'paw_total').single()

  if (data) {
    initialCount = data.count
  }
} catch (err) {
  console.error('Failed to fetch initial count on server:', err)
}
---

<footer>
  <!-- 1. 위쪽 영역: 소셜 아이콘들과 발바닥 버튼 -->
  <div class="footer-social-group">
    <!-- 중앙에 한 줄로 나열될 소셜 아이콘들 (유튜브 -> 블루스카이 -> 하트 순서) -->
    <div class="social-center-wrap">
      <div class="social-icons-row">
        <!-- 유튜브 링크 -->
        <a
          href="https://www.youtube.com/watch?v=HQbFM69RMnE"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            preserveAspectRatio="xMidYMid"
            viewBox="0 0 256 180"
          >
            <path
              fill="#E4CAD1"
              d="M250.346 28.075A32.18 32.18 0 0 0 227.69 5.418C207.824 0 127.87 0 127.87 0S47.912.164 28.046 5.582A32.18 32.18 0 0 0 5.39 28.24c-6.009 35.298-8.34 89.084.165 122.97a32.18 32.18 0 0 0 22.656 22.657c19.866 5.418 99.822 5.418 99.822 5.418s79.955 0 99.82-5.418a32.18 32.18 0 0 0 22.657-22.657c6.338-35.348 8.291-89.1-.164-123.134Z"
            ></path>
            <path fill="#FFF" d="m102.421 128.06 66.328-38.418-66.328-38.418z"></path>
          </svg>
        </a>

        <!-- 블루스카이 링크 -->
        <a
          href="https://bsky.app/profile/mudeul.bsky.social"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bluesky"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="16"
            preserveAspectRatio="xMidYMid"
            viewBox="0 0 256 226"
          >
            <path
              fill="#E4CAD1"
              d="M55.491 15.172c29.35 22.035 60.917 66.712 72.509 90.686 11.592-23.974 43.159-68.651 72.509-90.686C221.686-.727 256-13.028 256 26.116c0 7.818-4.482 65.674-7.111 75.068-9.138 32.654-42.436 40.983-72.057 35.942 51.775 8.812 64.946 38 36.501 67.187-54.021 55.433-77.644-13.908-83.696-31.676-1.11-3.257-1.63-4.78-1.637-3.485-.008-1.296-.527.228-1.637 3.485-6.052 17.768-29.675 87.11-83.696 31.676-28.445-29.187-15.274-58.375 36.5-67.187-29.62 5.041-62.918-3.288-72.056-35.942C4.482 91.79 0 33.934 0 26.116 0-13.028 34.314-.727 55.491 15.172Z"
            ></path>
          </svg>
        </a>

        <!-- 하트 링크 -->
        <a
          href="https://img.mudeul.page/f9cad783e27f87d18289ade2cdff9f47.png"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="lucky"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="#E4CAD1">
            <path
              d="M178,44c-21.44,0-39.92,10.19-50,27.07C117.92,54.19,99.44,44,78,44A58.07,58.07,0,0,0,20,102c0,28.59,18,58.47,53.4,88.79a333.81,333.81,0,0,0,52.7,36.73,4,4,0,0,0,3.8,0,333.81,333.81,0,0,0,52.7-36.73C218,160.47,236,130.59,236,102A58.07,58.07,0,0,0,178,44Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- 2. 메인 페이지('/')일 때만 발자국 버튼 영역이 렌더링되도록 수정 -->
    {
      isHome && (
        <div class="paw-wrapper">
          <button id="pawBtn" class="paw-btn" title="다녀간 흔적 남기기">
            <span class="paw-text"> 👉 </span>
            <span class="paw-icon">🐾</span>
            {/* 3. 서버에서 미리 가져온 initialCount 값을 바로 HTML에 꽂아줍니다! */}
            <span id="pawCount" class="paw-number">
              {initialCount}
            </span>
          </button>
        </div>
      )
    }
  </div>

  <!-- 2. 아래쪽 영역: 카피라이트와 Powered by -->
  <div class="footer-content">
    <div class="copyright">
      <span class="date">&copy; {today.getFullYear()}</span>
      {themeConfig.site.author}
    </div>
    <div class="powered-by">
      Powered by{' '}
      <a href="https://astro.build">Astro</a> +{' '}
      <a href="https://github.com/the3ash/astro-chiri">Chiri</a>
    </div>
  </div>
</footer>

<style>
  /* 스타일은 기존과 동일 */
  footer {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-light);
    line-height: 1.75;
    color: var(--text-secondary);
    opacity: 0.75;
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .footer-social-group {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    position: relative;
  }

  .social-center-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-icons-row {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    justify-content: center;
  }

  .footer-social-group a {
    color: #e4cad1;
    display: flex;
    align-items: center;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .footer-social-group a:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .paw-wrapper {
    position: absolute;
    right: 30px;
    top: -200px;
    display: flex;
    align-items: center;
  }

  .paw-btn {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-secondary);
    padding: 0;
    font-family: pretendard, inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition:
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      color 0.2s ease;
    white-space: nowrap;
  }

  .paw-text {
    font-size: 13px;
    opacity: 1;
    color: #ac9fb6;
  }

  .paw-icon {
    font-size: 40px;
  }

  .paw-number {
    font-size: 13px;
    opacity: 1;
    color: #ac9fb6;
  }

  .paw-btn:hover {
    color: var(--text-primary);
    transform: scale(1.15);
  }

  .paw-btn:active {
    transform: scale(0.95);
  }

  @media (max-width: 768px) {
    .paw-wrapper {
      position: absolute;
      right: 30px;
      top: -110px;
    }
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    flex-wrap: nowrap;
    width: 100%;
  }

  .copyright,
  .powered-by {
    white-space: nowrap;
  }

  .copyright .date {
    opacity: 1;
  }

  footer a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  footer a:hover {
    color: var(--text-primary);
  }
</style>

<!-- 폭죽 효과 라이브러리 추가 -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
  import { createClient } from '@supabase/supabase-js'

  const supabaseUrl = 'https://hdbqwihlntywvgratfrx.supabase.co'
  const supabaseKey = 'sb_publishable_H686ApYaPygboh-6GXfoMQ_bHLA4qrq'
  const supabase = createClient(supabaseUrl, supabaseKey)

  declare var confetti: any

  document.addEventListener('astro:page-load', async () => {
    const pawBtn = document.getElementById('pawBtn') as HTMLButtonElement
    const pawCountSpan = document.getElementById('pawCount') as HTMLElement

    if (!pawBtn || !pawCountSpan) return

    // (참고: 이제 숫자는 서버에서 HTML에 미리 렌더링해서 보내주므로,
    // 페이지 열리자마자 0에서 깜빡이며 바뀔 필요 없이 처음부터 숫자가 예쁘게 떠 있습니다!)

    const getTodayDate = () => {
      const date = new Date()
      return date.toISOString().split('T')[0]
    }

    const today = getTodayDate()
    const lastClickedDate = localStorage.getItem('mudeul_paw_last_date')
    let hasClickedToday = lastClickedDate === today

    if (hasClickedToday) {
      pawBtn.style.opacity = '0.7'
    }

    // 발자국 버튼 클릭 시
    pawBtn.onclick = async () => {
      const rect = pawBtn.getBoundingClientRect()
      const x = (rect.left + rect.width / 2) / window.innerWidth
      const y = (rect.top + rect.height / 2) / window.innerHeight

      if (!hasClickedToday) {
        try {
          const { data: newCount, error } = await supabase.rpc('increment_paw')

          if (!error && newCount !== null) {
            pawCountSpan.textContent = newCount.toString()
            localStorage.setItem('mudeul_paw_last_date', today)
            hasClickedToday = true
            pawBtn.style.opacity = '0.7'
          }
        } catch (err) {
          console.error('Failed to increment paw count:', err)
        }

        // 폭죽 효과
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 80,
            spread: 70,
            origin: { x: x, y: y },
            colors: ['#E4CAD1', '#ac9fb6', '#ffffff', '#ffd1dc']
          })
        }
      } else {
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 25,
            spread: 40,
            origin: { x: x, y: y },
            colors: ['#E4CAD1', '#ac9fb6']
          })
        }

        pawBtn.style.transform = 'scale(1.15)'
        setTimeout(() => {
          pawBtn.style.transform = 'scale(1)'
        }, 150)
      }
    }
  })
</script>
