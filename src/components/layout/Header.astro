---
import { themeConfig } from '@/config'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'
---

<header>
  <nav>
    <!-- 왼쪽: 사이트 타이틀 -->
    <div class="nav-left">
      <a href="/" class="site-title">{themeConfig.site.title}</a>
    </div>

    <!-- 오른쪽: 테마 토글 및 드롭다운 메뉴 -->
    <div class="nav-right">
      {themeConfig.general.themeToggle && <ThemeToggle />}

      <div class="menu-container">
        <button id="menu-btn" aria-label="Menu" class="menu-btn">
          <!-- 햄버거 메뉴 아이콘 -->
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <!-- 펼쳐지는 메뉴 목록 -->
        <div id="dropdown-menu" class="dropdown-menu">
          <a href="/">home</a>
          <a href="/blog">blog</a>
          <a href="/bodong">bodong</a>
          <a href="/bookmarks">bookmarks</a>
          <a href="/conch">conch</a>
          <a href="/dreams">dreams</a>
          <a href="/scribble">scribble</a>
          <a href="/wind-ally">wind-ally</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Astro 페이지 전환(View Transitions) 시에도 메뉴가 정상 작동하도록 설정
  document.addEventListener('astro:page-load', () => {
    const menuBtn = document.getElementById('menu-btn')
    const dropdownMenu = document.getElementById('dropdown-menu')

    if (menuBtn && dropdownMenu) {
      menuBtn.onclick = (e) => {
        e.stopPropagation()
        dropdownMenu.classList.toggle('show')
      }

      window.onclick = () => {
        dropdownMenu.classList.remove('show')
      }
    }
  })
</script>

<style>
  header {
    margin: 0 auto;
    width: 100%;
    max-width: 42rem; /* 본문과 동일한 최대 폭 설정 */
    box-sizing: border-box;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 1rem 1rem 1rem; /* 본문과 동일한 좌우 패딩(1rem) 적용 */
    box-sizing: border-box;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
  }

  /* 사이트 타이틀 전용 스타일 */
  .site-title {
    font-weight: var(--font-weight-bold);
    color: #82c2ea; /* 요청하신 포인트 색상 적용 */
    text-decoration: none;
    font-size: 1rem;
    display: inline-block;
  }
  .site-title:hover {
    opacity: 0.7;
  }

  /* 나머지 일반 메뉴 링크들 */
  .dropdown-menu a {
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-block;
  }
  .dropdown-menu a:hover {
    opacity: 0.7;
  }

  /* 메뉴 버튼 스타일 */
  .menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
  }
  .menu-btn:hover {
    background: var(--code-bg);
  }

  /* 드롭다운 메뉴 박스 스타일 */
  .dropdown-menu {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    flex-direction: column;
    gap: 0.6rem;
    z-index: 100;
    min-width: 130px;
  }

  /* 토글 클래스가 붙었을 때 보이도록 설정 */
  .dropdown-menu.show {
    display: flex;
  }
  /* 나머지 일반 메뉴 링크들 */
  .dropdown-menu a {
    font-weight: normal; /* 평소 두께로 설정 (필요시 조절) */
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-block;
  }

  /* 👉 홈(Home) 링크만 아주 굵게 처리 */
  .dropdown-menu a[href='/'] {
    font-weight: 900; /* 숫자를 높여서 확실하게 굵게 만듦 */
  }

  .dropdown-menu a:hover {
    opacity: 0.7;
  }
</style>
