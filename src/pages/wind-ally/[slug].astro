---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection, render } from 'astro:content'
import BackButton from '@/components/ui/BackButton.astro'

export async function getStaticPaths() {
  const projects = await getCollection('wind-ally')
  return projects.map((item) => ({
    params: { slug: item.id },
    props: { item }
  }))
}

const { item } = Astro.props
const { Content } = await render(item)

const title = item.data.title ? `${item.data.title} - Wind-Ally` : `Wind-Ally - ${themeConfig.site.title}`
const description = item.data.description || '찰나의 목격자 상세 페이지'
---

<IndexLayout title={title} description={description}>
  <main class="wind-ally-detail-container">
    <!-- 👉 표준 플로팅 BackButton 적용 (Wind-Ally 목록으로 연결) -->
    <BackButton href="/wind-ally/" />

    <article class="wind-ally-article">
      <header class="article-header">
        <h1 class="article-title">{item.data.title || 'Untitled'}</h1>
        {
          item.data.pubDate && (
            <time class="article-date" datetime={new Date(item.data.pubDate).toISOString()}>
              {new Date(item.data.pubDate).toLocaleDateString('ko-KR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          )
        }
      </header>

      <!-- prose 클래스를 추가하여 다른 상세 페이지들과 통일감 부여 -->
      <div class="article-content prose">
        <Content />
      </div>
    </article>
  </main>
</IndexLayout>

<style>
  .wind-ally-detail-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem;
    position: relative;
  }

  .wind-ally-article {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .article-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text, #111);
  }

  .article-date {
    font-size: 0.85rem;
    color: var(--color-text-muted, #666);
  }

  .article-content {
    line-height: 1.7;
    color: var(--color-text, #222);
    word-break: keep-all;
  }
</style>

<!-- 전역 스타일로 본문 내 이미지 크기 강제 제어 -->
<style is:global>
  .article-content img {
    max-width: 100% !important;
    width: 100% !important;
    height: auto !important;
    display: block !important;
    margin: 1.5rem auto !important;
    border-radius: 4px;
    object-fit: contain;
  }

  /* 이미지 아래에 뜨는 alt 텍스트나 캡션 숨기기 */
  .article-content figcaption,
  .article-content .image-caption,
  .article-content alt {
    display: none !important;
  }
</style>
