---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Picture from '@/components/ui/Picture.astro';
import { withBase } from '@/lib/url';

// 🌟 꺽쇠(<> )를 완전히 배제하여 파서 깨짐 방지
let allProjects: any[] = [];
try {
  const collection = await getCollection('wind-ally');
  allProjects = collection.sort((a, b) => {
    const aData = a.data as any;
    const bData = b.data as any;
    const aPinned = aData.pinned || aData.pin ? 1 : 0;
    const bPinned = bData.pinned || bData.pin ? 1 : 0;
    if (aPinned !== bPinned) return bPinned - aPinned;

    const aFeatured = aData.featured ? 1 : 0;
    const bFeatured = bData.featured ? 1 : 0;
    if (aFeatured !== bFeatured) return bFeatured - aFeatured;

    return 0;
  });
} catch (_e) {
  allProjects = [];
}

// 모든 프로젝트에서 tech(기술 스택) 목록 추출 및 중복 제거
const allTagsSet = new Set<string>();
allProjects.forEach((project) => {
  const projectData = project.data as any;
  if (projectData.tech && Array.isArray(projectData.tech)) {
    projectData.tech.forEach((techItem: any) => {
      if (typeof techItem === 'string') {
        allTagsSet.add(techItem);
      }
    });
  }
});
const tags = Array.from(allTagsSet);
---

<BaseLayout title="Wind-ally" description="찰나의 목격자">
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">Wind-Ally</h1>
        <p class="page-description">찰나의 목격자</p>
      </Container>
    </section>

    <section class="section">
      <Container>
        <div class="portfolio-wrapper">
          {/* 기술 스택 카테고리 필터 버튼 영역 */}
          {
            tags.length > 0 && (
              <div class="filter-tags" aria-label="Filter by tech stack">
                <button class="tag-btn active" data-tag="all">
                  All
                </button>
                {tags.map((tag) => (
                  <button class="tag-btn" data-tag={tag}>
                    {tag}
                  </button>
                ))}
              </div>
            )
          }

          {/* 인스타그램 스타일 3열 사진 그리드 */}
          <div class="portfolio-grid">
            {
              allProjects.map((project) => {
                const projectData = project.data as any;
                const projectTechs = projectData.tech || [];
                const dataTagsAttr = projectTechs.join(',');
                const isPinned = Boolean(projectData.pinned || projectData.pin);

                return (
                  <a
                    href={withBase(`/wind-ally/${project.id}/`)}
                    class="portfolio-item"
                    data-tags={dataTagsAttr}
                  >
                    {/* 🌟 왼쪽 상단에 위치하고 반투명한 흰색 배경이 적용된 핀 아이콘 */}
                    {isPinned && (
                      <span class="pinned-badge" title="Pinned">
                        <svg
                          class="pinned-icon"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          width="14"
                          height="14"
                          fill="currentColor"
                          aria-label="Pinned"
                        >
                          <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" />
                        </svg>
                      </span>
                    )}

                    {projectData.cover ? (
                      <Picture
                        src={projectData.cover}
                        alt={projectData.title || 'Project Image'}
                        widths={[400, 800]}
                        sizes="(min-width: 1024px) 33vw, 100vw"
                        loading="lazy"
                      />
                    ) : (
                      <div class="portfolio-placeholder">
                        <span>No Image</span>
                      </div>
                    )}
                  </a>
                );
              })
            }
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  function initWindAllyFilter() {
    const filterButtons = document.querySelectorAll('.tag-btn');
    const items = document.querySelectorAll('.portfolio-item');

    if (filterButtons.length === 0 || items.length === 0) return;

    filterButtons.forEach((btn) => {
      btn.removeEventListener('click', handleFilterClick);
      btn.addEventListener('click', handleFilterClick);
    });
  }

  function handleFilterClick(this: HTMLElement) {
    const filterButtons = document.querySelectorAll('.tag-btn');
    const items = document.querySelectorAll('.portfolio-item');

    filterButtons.forEach((b) => b.classList.remove('active'));
    this.classList.add('active');

    const selectedTag = this.getAttribute('data-tag');

    items.forEach((item) => {
      const el = item as HTMLElement;
      const itemTags = el.getAttribute('data-tags')?.split(',') || [];
      const matches =
        selectedTag === 'all' ||
        (selectedTag && itemTags.includes(selectedTag));

      if (matches) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initWindAllyFilter);
  document.addEventListener('astro:page-load', initWindAllyFilter);
</script>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  /* 블로그와 동일한 헤더 여백 및 타이틀 스타일 */
  .page-header {
    text-align: center;
    padding: var(--space-3xl) 0 var(--space-xs) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-md) 0 var(--space-3xl) 0;
  }

  :global(.section .container),
  :global(.page-header .container) {
    max-width: 38rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .portfolio-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
  }

  /* 필터 버튼 영역 정렬 */
  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
    margin-bottom: var(--space-sm);
  }

  .tag-btn {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    padding: var(--space-xs) var(--space-md);
    border-radius: 9999px;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .tag-btn.active,
  .tag-btn:hover {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .portfolio-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-surface);
    display: block;
    border-radius: 6px;
  }

  .pinned-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    z-index: 2;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pinned-icon {
    color: var(--color-accent, #e066ff);
    transform: rotate(45deg);
  }

  .portfolio-item.hidden {
    display: none !important;
  }

  .portfolio-item :global(figure),
  .portfolio-item :global(.picture-wrapper),
  .portfolio-item :global(picture) {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .portfolio-item :global(figcaption) {
    display: none !important;
  }

  .portfolio-item :global(img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .portfolio-item:hover :global(img) {
    transform: scale(1.02);
    filter: brightness(0.95);
  }

  .portfolio-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }
    .portfolio-grid {
      gap: 3px;
    }
  }
</style>
