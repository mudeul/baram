---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection } from 'astro:content'

let allProjects: any[]

try {
  const collection = await getCollection('wind-ally')
  allProjects = collection.sort((a, b) => {
    const aData = a.data as any
    const bData = b.data as any
    const aPinned = aData.pinned || aData.pin ? 1 : 0
    const bPinned = bData.pinned || bData.pin ? 1 : 0
    if (aPinned !== bPinned) return bPinned - aPinned

    const aDate = aData.pubDate ? new Date(aData.pubDate).getTime() : 0
    const bDate = bData.pubDate ? new Date(bData.pubDate).getTime() : 0
    return bDate - aDate
  })
} catch {
  allProjects = []
}

const allTagsSet = new Set<string>()
allProjects.forEach((item) => {
  const projectData = item.data as any
  const techList = projectData.tech || projectData.tags

  if (techList) {
    if (Array.isArray(techList)) {
      techList.forEach((t: unknown) => {
        if (typeof t === 'string' && t.trim()) allTagsSet.add(t.trim())
      })
    } else if (typeof techList === 'string' && techList.trim()) {
      techList.split(',').forEach((t) => {
        if (t.trim()) allTagsSet.add(t.trim())
      })
    }
  }
})
const tags = Array.from(allTagsSet)
---

<IndexLayout title={`Wind-Ally - ${themeConfig.site.title}`} description="찰나의 목격자">
  <main class="wind-ally-container">
    <div class="wind-ally-wrapper">
      <div style="margin-bottom: 0.25rem;">
        <h1 style="font-size: 1rem !important; font-weight: 700 !important; margin-bottom: 0.25rem !important;">
          Wind-Ally
        </h1>
        <p
          style="font-size: 0.75rem !important; line-height: 1.4; margin: 0 !important;"
          class="text-gray-500 dark:text-gray-400"
        >
          찰나의 목격자
        </p>
      </div>

      {
        tags.length > 0 && (
          <div class="filter-tags" aria-label="Filter by tech stack">
            <button class="tag-btn active" data-tag="all">
              All
            </button>
            {tags.map((tag) => (
              <button class="tag-btn" data-tag={tag}>
                {tag}
              </button>
            ))}
          </div>
        )
      }

      <div class="wind-ally-grid">
        {
          allProjects.map((item) => {
            const projectData = item.data as any
            const coverImage = projectData.cover || projectData.image
            const isPinned = Boolean(projectData.pinned || projectData.pin)

            const rawTechs = projectData.tech || projectData.tags
            let itemTags: string[] = []
            if (Array.isArray(rawTechs)) {
              itemTags = rawTechs.map((t) => String(t).trim()).filter(Boolean)
            } else if (typeof rawTechs === 'string') {
              itemTags = rawTechs
                .split(',')
                .map((t) => t.trim())
                .filter(Boolean)
            }
            const dataTagsAttr = itemTags.join(',')

            return (
              <a href={`/wind-ally/${item.id}/`} class="wind-ally-item" data-tags={dataTagsAttr}>
                {isPinned && (
                  <span class="pinned-badge" title="Pinned">
                    <svg
                      class="pinned-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                      fill="currentColor"
                      aria-label="Pinned"
                    >
                      <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" />
                    </svg>
                  </span>
                )}

                {coverImage ? (
                  <img
                    src={coverImage}
                    alt={projectData.title || 'Wind-Ally image'}
                    loading="lazy"
                    class="wind-ally-img"
                  />
                ) : (
                  <div class="wind-ally-placeholder">
                    <span>{projectData.title || 'No Image'}</span>
                  </div>
                )}
              </a>
            )
          })
        }
      </div>
    </div>
  </main>
</IndexLayout>

<script>
  function initWindAllyFilter() {
    const filterButtons = document.querySelectorAll('.tag-btn')
    const items = document.querySelectorAll('.wind-ally-item')

    if (filterButtons.length === 0 || items.length === 0) return

    filterButtons.forEach((btn) => {
      btn.removeEventListener('click', handleFilterClick)
      btn.addEventListener('click', handleFilterClick)
    })
  }

  function handleFilterClick(this: HTMLElement) {
    const filterButtons = document.querySelectorAll('.tag-btn')
    const items = document.querySelectorAll('.wind-ally-item')

    filterButtons.forEach((b) => b.classList.remove('active'))
    this.classList.add('active')

    const selectedTag = this.getAttribute('data-tag')

    items.forEach((item) => {
      const el = item as HTMLElement
      const itemTags = el.getAttribute('data-tags')?.split(',') || []
      const matches = selectedTag === 'all' || (selectedTag && itemTags.includes(selectedTag))

      if (matches) {
        el.classList.remove('hidden')
      } else {
        el.classList.add('hidden')
      }
    })
  }

  document.addEventListener('DOMContentLoaded', initWindAllyFilter)
  document.addEventListener('astro:page-load', initWindAllyFilter)
</script>

<style>
  .wind-ally-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 0rem;
  }

  .wind-ally-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 0.5rem 0;
  }

  .tag-btn {
    background: var(--color-surface, rgba(125, 125, 125, 0.08));
    border: 1px solid var(--color-border, #eaeaea);
    color: var(--color-text-muted, #666);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag-btn.active,
  .tag-btn:hover {
    background: #eceafa;
    color: #555555;
    border-color: #eceafa;
  }

  .wind-ally-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    margin-top: 0.5rem;
  }

  .wind-ally-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    background-color: var(--color-surface, rgba(125, 125, 125, 0.1));
    display: block;
    transition: opacity 0.2s ease;
  }

  .wind-ally-item:hover {
    opacity: 0.85;
  }

  .wind-ally-item.hidden {
    display: none !important;
  }

  .pinned-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    z-index: 2;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pinned-icon {
    color: #eceafa;
    transform: rotate(45deg);
  }

  .wind-ally-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wind-ally-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-text-muted, #666);
    text-align: center;
    padding: 4px;
    word-break: keep-all;
  }

  @media (max-width: 640px) {
    .wind-ally-grid {
      gap: 2px;
    }
  }
</style>
