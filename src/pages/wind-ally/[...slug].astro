---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import ProjectGallery from '@/components/portfolio/ProjectGallery.astro';
import siteConfig from '@/site.config';
import { classifyHref, withBase } from '@/lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('wind-ally');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<'wind-ally'>;

const project = Astro.props;
const { Content } = await render(project);
const description = project.data.description ?? project.data.summary;

const projectLinks = [
  project.data.links?.live && {
    label: 'Visit live site',
    href: project.data.links.live,
    external: true,
  },
  project.data.links?.github && {
    label: 'View source',
    href: project.data.links.github,
    external: true,
  },
  project.data.links?.case && {
    label: 'Read case study',
    href: withBase(project.data.links.case),
    external: classifyHref(project.data.links.case) === 'external',
  },
].filter((link): link is { label: string; href: string; external: boolean } =>
  Boolean(link),
);
---

<BaseLayout title={project.data.title} description={description}>
  <Header />

  <main id="main" tabindex="-1">
    <article>
      <header class="case-hero">
        <Container size="xl">
          <a class="case-hero__back" href={withBase('/wind-ally/')}
            >← All Wind-Ally</a
          >

          <div class="case-hero__heading">
            <p class="case-hero__kicker">Selected project</p>
            <h1>{project.data.title}</h1>
          </div>
        </Container>
      </header>

      <Container size="xl">
        <div class="case-content-wrapper">
          <div class="case-content">
            <div class="prose">
              <Content />
            </div>

            {
              projectLinks.length > 0 && (
                <div class="case-actions" aria-label="Project links">
                  {projectLinks.map((link, index) => (
                    <Button
                      href={link.href}
                      variant={index === 0 ? 'solid' : 'outline'}
                      external={link.external}
                    >
                      {link.label}
                      <span aria-hidden="true">↗</span>
                    </Button>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </Container>

      {
        project.data.images && (
          <Container size="xl">
            <ProjectGallery
              images={project.data.images}
              title={project.data.title}
            />
          </Container>
        )
      }

      <Container size="xl">
        <nav class="case-next" aria-label="Portfolio navigation">
          <p>End of case file</p>
          <a href={withBase('/wind-ally/')}>
            Explore all Wind-Ally
            <span aria-hidden="true">→</span>
          </a>
        </nav>
      </Container>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .case-hero {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .case-hero__back {
    display: inline-flex;
    margin-bottom: clamp(2rem, 5vw, 4rem);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .case-hero__back:hover {
    color: var(--color-accent);
  }

  .case-hero__heading {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1.3fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .case-hero__kicker {
    padding-top: var(--space-sm);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-hero h1 {
    max-width: 13ch;
    margin-bottom: 0;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .case-content-wrapper {
    display: flex;
    justify-content: center;
    padding-top: var(--space-2xl);
  }

  .case-content {
    min-width: 0;
    width: 100%;
    max-width: 48rem;
  }

  .prose :global(h2) {
    margin: var(--space-3xl) 0 var(--space-lg);
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
  }

  .prose :global(h3) {
    margin: var(--space-2xl) 0 var(--space-md);
    font-size: var(--text-xl);
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .prose :global(p) {
    margin-bottom: var(--space-lg);
  }

  .prose :global(strong) {
    color: var(--color-text);
  }

  .prose :global(blockquote) {
    margin: var(--space-2xl) 0;
    padding: var(--space-lg) 0 var(--space-lg) var(--space-xl);
    border-left: 1px solid var(--glass-border);
    color: var(--color-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--text-2xl);
    line-height: 1.45;
  }

  .prose :global(blockquote p) {
    margin: 0;
    color: inherit;
  }

  /* 본문 안의 이미지 모서리 둥글게 처리 */
  .prose :global(img) {
    border-radius: var(--radius-lg, 1rem);
    overflow: hidden;
    margin-block: var(--space-xl);
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-3xl);
  }

  .case-next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-top: calc(var(--space-3xl) * 1.5);
    padding-block: var(--space-xl);
    border-block: 1px solid var(--glass-border);
  }

  .case-next p {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-next a {
    display: inline-flex;
    gap: var(--space-md);
    align-items: center;
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .case-next a span {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .case-hero__heading {
      display: block;
    }

    .case-hero__kicker {
      margin-bottom: var(--space-lg);
    }

    .case-next {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
