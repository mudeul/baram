---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const dreams = await getCollection('dreams');
  return dreams.map((dream) => ({
    params: { slug: dream.id },
    props: dream,
  }));
}

type Props = CollectionEntry<'dreams'>;

const dream = Astro.props;
const { Content } = await render(dream);

// 날짜 포맷팅 (2026.09.11 형태)
const pubDate = dream.data.pubDate;
const year = pubDate.getFullYear();
const month = String(pubDate.getMonth() + 1).padStart(2, '0');
const day = String(pubDate.getDate()).padStart(2, '0');
const formattedDate = `${year}.${month}.${day}`;
---

<BaseLayout title={dream.data.title} description={dream.data.description}>
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <article class="dream-post">
      <div class="container">
        <!-- 블로그와 동일한 헤더 카드 구조 -->
        <GlassPanel variant="solid" padding="xl" className="post-header">
          <a href={withBase('/dreams/')} class="post-back">← Back to dreams</a>
          <time class="post-date" datetime={pubDate.toISOString()}>
            {formattedDate}
          </time>
          <h1 class="post-title">{dream.data.title}</h1>
        </GlassPanel>

        <!-- 블로그와 동일한 본문 바디 및 카드 구조 (.post-body로 여백 제어) -->
        <div class="post-body">
          <GlassPanel variant="solid" padding="xl" className="post-content">
            <div class="prose">
              <Content />
            </div>
          </GlassPanel>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
  }

  .dream-post {
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: 41rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .post-back {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-md);
    transition: color var(--transition-fast);
  }

  .post-back:hover {
    color: var(--color-accent);
  }

  .post-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--space-lg); /* 블로그와 동일한 헤더 하단 여백 */
  }

  .post-back {
    align-self: flex-start;
  }

  .post-date {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .post-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.3;
    margin: 0;
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 블로그와 동일한 post-body 구조를 사용하여 카드 간 간격 제어 */
  .post-body {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .prose {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text);
  }

  .prose :global(p) {
    margin-bottom: var(--space-lg);
    color: var(--color-text-muted);
  }

  .prose :global(strong) {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: var(--text-2xl);
    }
    .dream-post {
      padding: var(--space-lg) 0;
    }
  }
</style>
