---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Tag from '@/components/ui/Tag.astro';
import Picture from '@/components/ui/Picture.astro';
import { withBase } from '@/lib/url';
import { formatDate } from '@/lib/date';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async () => {
  const dreams = await getCollection('dreams', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return dreams.map((dream) => ({
    params: { slug: dream.id },
    props: { dream },
  }));
}) satisfies GetStaticPaths;

const { dream } = Astro.props;
const { Content } = await render(dream);

const formattedDate = formatDate(dream.data.pubDate);
const updatedDate = dream.data.updatedDate
  ? formatDate(dream.data.updatedDate)
  : undefined;
---

<BaseLayout
  title={dream.data.title}
  description={dream.data.description}
  ogImage={withBase(`/og/dreams/${dream.id}.png`)}
  article={{
    publishedTime: dream.data.pubDate.toISOString(),
    modifiedTime: dream.data.updatedDate?.toISOString(),
  }}
>
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <article class="dream-post">
      <div class="container">
        <GlassPanel variant="solid" padding="xl" className="post-header">
          <a href={withBase('/dreams/')} class="post-back">← Back to dreams</a>
          <h1 class="post-title">{dream.data.title}</h1>

          <div class="post-meta">
            <time datetime={dream.data.pubDate.toISOString()}
              >{formattedDate}</time
            >
            {
              updatedDate && (
                <>
                  <span class="separator" aria-hidden="true">
                    ·
                  </span>
                  <span>Updated {updatedDate}</span>
                </>
              )
            }
          </div>

          {
            dream.data.tags && dream.data.tags.length > 0 && (
              <div class="post-tags">
                {dream.data.tags.map((tag) => (
                  <Tag name={tag} />
                ))}
              </div>
            )
          }
        </GlassPanel>

        {
          dream.data.heroImage && (
            <div
              class="post-hero-image"
              transition:name={`dream-image-${dream.id}`}
            >
              <Picture
                src={dream.data.heroImage}
                alt={dream.data.heroImageAlt ?? dream.data.title}
                widths={[600, 1200, 1600]}
                sizes="(min-width: 1024px) 720px, 100vw"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }

        <div class="post-body">
          <GlassPanel variant="solid" padding="xl" className="post-content">
            <div class="prose">
              <Content />
            </div>
          </GlassPanel>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
  }

  .dream-post {
    padding: var(--space-2xl) 0;
  }

  .dream-post .container {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  .post-back {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-md);
    transition: color var(--transition-fast);
    align-self: flex-start;
  }
  .post-back:hover {
    color: var(--color-accent);
  }

  .post-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .post-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: var(--space-lg);
    text-align: center;
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .separator {
    opacity: 0.5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .post-hero-image {
    margin-bottom: var(--space-lg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--glass-shadow);
  }

  .post-hero-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 본문 카드 위쪽 간격을 아주 좁게(xs) 밀착 */
  .post-body {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .prose {
    font-size: var(--text-base);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: var(--text-3xl);
    }
    .post-meta {
      font-size: var(--text-xs);
    }
    .dream-post {
      padding: var(--space-lg) 0;
    }
  }
</style>
