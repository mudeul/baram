---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection } from 'astro:content'

const dreams = (await getCollection('dreams')).sort(
  (a, b) => new Date(b.data.pubDate ?? 0).valueOf() - new Date(a.data.pubDate ?? 0).valueOf()
)

function formatDate(date: Date | undefined) {
  if (!date) return ''
  const d = new Date(date)
  const year = d.getFullYear()
  const month = String(d.getMonth() + 1).padStart(2, '0')
  const day = String(d.getDate()).padStart(2, '0')
  return `${year}.${month}.${day}`
}
---

<IndexLayout title={`Dreams - ${themeConfig.site.title}`} description="'하늘에는 온통 먹물처럼 꿈꾼 흔적 뿐이다.'">
  <main class="main-content">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-extrabold mb-2">Dreams</h1>
      <p class="text-gray-500 dark:text-gray-400 text-sm">'하늘에는 온통 먹물처럼 꿈꾼 흔적 뿐이다.'</p>
    </div>

    <div class="max-w-2xl mx-auto">
      {
        dreams.length > 0 ? (
          <div class="timeline">
            {dreams.map((dream) => (
              <div class="timeline-item">
                <div class="timeline-dot" />
                <article class="p-5 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm transition dream-card">
                  <div class="dream-content" style="padding-left: 1.25rem;">
                    <span class="dream-date">{formatDate(dream.data.pubDate)}</span>
                    <h2 class="dream-post-title">
                      <a href={`/dreams/${dream.id}/`}>{dream.data.title}</a>
                    </h2>
                    {dream.data.description && <p class="dream-excerpt">{dream.data.description}</p>}
                  </div>
                </article>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-center text-gray-400 py-12">아직 기록된 꿈이 없습니다.</p>
        )
      }
    </div>
  </main>
</IndexLayout>

<style>
  .main-content {
    width: 100%;
  }

  /* 타임라인 컨테이너 */
  .timeline {
    position: relative;
    padding-left: 2.5rem;
  }

  /* 타임라인 수직 연결선 위치 */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.85rem;
    width: 1px;
    background-color: var(--border);
    z-index: 1;
  }

  /* 각 타임라인 아이템 */
  .timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
  }

  /* 타임라인 동그라미 마커 위치 */
  .timeline-dot {
    position: absolute;
    left: calc(-2.5rem + 0.85rem);
    top: 1.5rem;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--text-primary);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--border);
    z-index: 2;
  }

  /* 꿈 카드 호버 효과 */
  .dream-card {
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .dream-card:hover {
    transform: translateY(-2px);
    border-color: var(--text-tertiary);
  }

  .dream-date {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .dream-post-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .dream-post-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .dream-post-title a:hover {
    color: var(--text-secondary);
  }

  .dream-excerpt {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 2rem;
    }
    .timeline-dot {
      left: calc(-2rem + 0.85rem);
    }
  }
</style>
