---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/url';

const dreams = (await getCollection('dreams')).sort(
  (a, b) =>
    new Date(b.data.pubDate ?? 0).valueOf() -
    new Date(a.data.pubDate ?? 0).valueOf(),
);

function formatDate(date: Date | undefined) {
  if (!date) return '';
  const d = new Date(date);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}.${month}.${day}`;
}
---

<BaseLayout title="Dreams" description="꿈 기록 저장소">
  <Header />

  <main id="main" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">Dreams</h1>
        <p class="page-description">꿈 기록 저장소</p>
      </Container>
    </section>

    <section class="section">
      <Container>
        {
          dreams.length > 0 ? (
            <div class="timeline">
              {dreams.map((dream) => (
                <div class="timeline-item">
                  <div class="timeline-dot" />
                  <article class="glass-panel dream-card">
                    <div class="dream-content">
                      <span class="dream-date">
                        {formatDate(dream.data.pubDate)}
                      </span>
                      <h2 class="dream-post-title">
                        <a href={withBase(`/dreams/${dream.id}/`)}>
                          {dream.data.title}
                        </a>
                      </h2>
                      {dream.data.description && (
                        <p class="dream-excerpt">{dream.data.description}</p>
                      )}
                    </div>
                  </article>
                </div>
              ))}
            </div>
          ) : (
            <p class="empty-state">아직 기록된 꿈이 없습니다.</p>
          )
        }
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  .page-header {
    text-align: center;
    padding: calc(var(--space-3xl) - 4px) 0 var(--space-xl) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-2xl) 0 var(--space-3xl) 0;
  }

  /* 타임라인 컨테이너 */
  .timeline {
    position: relative;
    padding-left: 2rem;
    padding-top: var(--space-md);
    padding-bottom: var(--space-3xl);
    max-width: 44rem;
    margin-inline: auto;
  }

  /* 타임라인 수직 연결선 */
  .timeline::before {
    content: '';
    position: absolute;
    top: var(--space-md);
    bottom: var(--space-3xl);
    left: 0.75rem;
    width: 1px;
    background-color: var(--color-accent);
    opacity: 0.3;
    z-index: 1;
  }

  /* 각 타임라인 아이템 */
  .timeline-item {
    position: relative;
    margin-bottom: var(--space-lg);
  }

  /* 타임라인 동그라미 마커 */
  .timeline-dot {
    position: absolute;
    left: calc(-2rem + 0.755rem);
    top: 1.5rem;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border);
    z-index: 2;
  }

  /* 카드 스타일 결합 */
  .dream-card {
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .dream-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .dream-date {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .dream-post-title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .dream-post-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .dream-post-title a:hover {
    color: var(--color-accent);
  }

  .dream-excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }
    .timeline {
      padding-left: 1.75rem;
    }
    .timeline-dot {
      left: calc(-1.75rem + 0.75rem);
      width: 9px;
      height: 9px;
    }
  }
</style>
