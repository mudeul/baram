---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import { withBase } from '@/lib/url';
import { formatDate } from '@/lib/date';
import { getCollection } from 'astro:content';

const dreams = await getCollection('dreams', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// 최신순 정렬
dreams.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Dreams"
  description="A collection of thoughts, dreams, and records."
>
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <div class="container">
      <div class="page-header">
        <h1 class="page-title">Dreams</h1>
        <p class="page-description">기록하고 꿈꾸는 공간입니다.</p>
      </div>

      <!-- 타임라인 컨테이너 -->
      <div class="timeline">
        {
          dreams.length === 0 ? (
            <GlassPanel variant="default" padding="xl" className="empty-state">
              <p>아직 기록된 꿈이 없습니다. 첫 번째 꿈을 남겨보세요!</p>
            </GlassPanel>
          ) : (
            dreams.map((dream) => (
              <div class="timeline-item">
                {/* 타임라인의 동그라미 포인트 */}
                <div class="timeline-dot" />

                {/* 글 내용 패널 */}
                <GlassPanel
                  variant="solid"
                  padding="lg"
                  className="timeline-content"
                >
                  <time class="timeline-date">
                    {formatDate(dream.data.pubDate)}
                  </time>
                  <h2 class="timeline-post-title">
                    <a href={withBase(`/dreams/${dream.id}/`)}>
                      {dream.data.title}
                    </a>
                  </h2>
                  {dream.data.description && (
                    <p class="timeline-excerpt">{dream.data.description}</p>
                  )}
                </GlassPanel>
              </div>
            ))
          )
        }
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  /* 타임라인 구조 */
  .timeline {
    position: relative;
    /* 선이 그려질 공간을 위해 왼쪽에 여백 확보 */
    padding-left: 2rem;
    margin-left: 1rem;
  }

  /* 타임라인 수직 연결선 (눈에 잘 띄도록 accent 컬러나 명확한 색상 사용) */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    background-color: var(--color-accent, #3b82f6); /* 색상이 안 보일 경우를 대비해 파란빛 기본값 fallback 추가 */
    z-index: 5; /* 카드가 가리지 않도록 앞으로 배치 */
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-xl);
  }

  /* 타임라인 동그라미 마커 */
  .timeline-dot {
    position: absolute;
    /* 선(left: 0)의 위치에 정확히 맞춤 */
    left: calc(-2rem - 1px); 
    top: 1.5rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent, #3b82f6);
    border: 3px solid var(--color-bg, #ffffff);
    box-shadow: 0 0 0 2px var(--color-border);
    z-index: 10; /* 선보다 위로 오게 설정 */
  }

  .timeline-content {
    transition: transform var(--transition-fast);
  }

  .timeline-content:hover {
    transform: translateY(-2px);
  }

  .timeline-date {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .timeline-post-title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .timeline-post-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .timeline-post-title a:hover {
    color: var(--color-accent);
  }

  .timeline-excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 1.5rem;
      margin-left: 0.5rem;
    }
    .timeline-dot {
      left: calc(-1.5rem - 1px);
      width: 12px;
      height: 12px;
    }
  }
</style>