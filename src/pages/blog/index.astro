---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/url';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pagePosts = posts.slice(0, 10);

function formatDate(date: Date) {
  const d = new Date(date);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}.${month}.${day}`;
}
---

<BaseLayout title="Blog" description="♪ 무서운 얘기를 해 줄까">
  <Header />

  <main id="main" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">Blog</h1>
        <p class="page-description">♪ 무서운 얘기를 해 줄까</p>
      </Container>
    </section>

    <section class="section">
      <Container>
        <ul class="blog-list">
          {
            pagePosts.map((post) => (
              <li class="blog-list-item">
                <a href={withBase(`/blog/${post.id}/`)} class="blog-list-link">
                  <span class="post-title">{post.data.title}</span>
                  <div class="post-meta">
                    <span class="post-date">
                      {formatDate(post.data.pubDate)}
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  .page-header {
    text-align: center;
    padding: calc(var(--space-3xl) - 4px) 0 var(--space-xl) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-2xl) 0 var(--space-3xl) 0;
  }

  .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 34rem;
    width: 90%;
    margin-inline: auto;
  }

  .blog-list-item {
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: var(--space-md);
  }

  .blog-list-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .post-title {
    font-size: calc(var(--text-lg) * 0.8);
    font-weight: 500;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .blog-list-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    flex-shrink: 0;
    font-size: calc(var(--text-sm) * 0.9);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }
  }
</style>
