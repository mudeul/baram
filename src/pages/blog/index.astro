---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Container from '@/components/ui/Container.astro';
import PostGrid from '@/components/blog/PostGrid.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { getPublishedPosts, splitFeatured } from '@/lib/posts';
import siteConfig from '@/site.config';

const allPosts = await getPublishedPosts();
const perPage = siteConfig.blog.postsPerPage;

// Featured 포스트 분할 로직은 유지하되, 화면에 따로 렌더링하지 않고
// 전체 글 목록에서 다루도록 처리합니다.
const { rest } = splitFeatured(allPosts);
const totalPages = Math.max(1, Math.ceil(rest.length / perPage));
const pagePosts = rest.slice(0, perPage);
---

<BaseLayout
  title="Blog"
  description="Insights, tutorials, and updates from the Astro Haze blog"
>
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <section class="section">
      <Container>
        <h2 class="section-title">All Posts</h2>

        {
          allPosts.length === 0 ? (
            <GlassPanel variant="default" padding="xl" className="empty-state">
              <p>No blog posts yet. Check back soon!</p>
            </GlassPanel>
          ) : (
            <>
              <PostGrid posts={pagePosts} />
              <Pagination
                currentPage={1}
                totalPages={totalPages}
                basePath="/blog"
              />
            </>
          )
        }
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh; /* fallback */
    min-height: 100dvh;
  }

  .section {
    padding: var(--space-3xl) 0;
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .empty-state {
    text-align: center;
    max-width: 500px;
    margin: 0 auto;
  }

  .empty-state p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin: 0;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: var(--text-2xl);
    }
    .section {
      padding: var(--space-2xl) 0;
    }
  }
</style>
