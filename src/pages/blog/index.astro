---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import PostGrid from '@/components/blog/PostGrid.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pagePosts = posts.slice(0, 10);
---

<BaseLayout title="Blog" description="Insights, tutorials, and updates.">
  <main id="main" tabindex="-1" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">Blog</h1>
        <p class="page-description">
          Insights, tutorials, and updates about web development, design, and
          technology.
        </p>
      </Container>
    </section>

    <section class="section">
      <Container>
        <PostGrid posts={pagePosts} />
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
  }

  .page-header {
    padding: var(--space-3xl) 0 var(--space-xl) 0;
    text-align: center;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .section {
    padding: var(--space-2xl) 0 var(--space-3xl) 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }
  }
</style>
