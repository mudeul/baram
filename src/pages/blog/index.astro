---
import IndexLayout from '../../layouts/IndexLayout.astro'
import PostList from '../../components/widgets/PostList.astro'
import { themeConfig } from '../../config'
import { getCollection } from 'astro:content'

const posts = await getCollection('blog')

// 날짜 최신순 정렬 및 URL에 카테고리(blog/) 접두사 추가
const sortedPosts = posts
  .sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
    return dateB - dateA
  })
  .map((post) => ({
    ...post,
    // PostList에서 사용하는 id 또는 slug 경로를 /blog/slug 형태로 변경
    id: `blog/${post.id}`
  }))
---

<IndexLayout title={`Blog - ${themeConfig.site.title}`} description={themeConfig.site.description}>
  <main class="wind-ally-container">
    <div class="wind-ally-wrapper">
      <h1 class="text-base font-bold mb-2">Blog</h1>
      <PostList posts={sortedPosts} />
    </div>
  </main>
</IndexLayout>

<style>
  .wind-ally-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .wind-ally-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  /* Bookmarks 페이지와 제목 크기/굵기 동일하게 맞춤 */
  main h1 {
    font-size: 1rem !important;
    font-weight: 700 !important;
    margin-bottom: 0.5rem !important;
  }
</style>
