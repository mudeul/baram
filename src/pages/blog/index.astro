---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/url';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pagePosts = posts.slice(0, 10);

function formatDate(date: Date) {
  const d = new Date(date);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}.${month}.${day}`;
}
---

<BaseLayout title="Blog" description="♪ 무서운 얘기를 해 줄까">
  <Header />

  <main id="main" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">Blog</h1>
        <p class="page-description">♪ 무서운 얘기를 해 줄까</p>
      </Container>
    </section>

    <section class="section">
      <Container>
        <ul class="blog-list">
          {
            pagePosts.map((post) => (
              <li class="blog-list-item">
                <GlassPanel
                  variant="solid"
                  padding="md"
                  className="blog-card-panel"
                >
                  <a
                    href={withBase(`/blog/${post.id}/`)}
                    class="blog-list-link"
                  >
                    <span class="post-title">{post.data.title}</span>
                    <div class="post-meta">
                      {post.data.pubDate && (
                        <time
                          datetime={post.data.pubDate.toISOString()}
                          class="post-date"
                        >
                          {formatDate(post.data.pubDate)}
                        </time>
                      )}
                    </div>
                  </a>
                </GlassPanel>
              </li>
            ))
          }
        </ul>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  .page-header {
    text-align: center;
    padding: var(--space-3xl) 0 var(--space-xs) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-md) 0 var(--space-3xl) 0;
  }

  :global(.section .container),
  :global(.page-header .container) {
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
  }

  .blog-list-item {
    /* 개별 리스트 아이템 스타일 초기화 */
  }

  /* GlassPanel 호버 시 미세한 반응이나 인터랙션 효과 추가 가능 */
  :global(.blog-card-panel) {
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  :global(.blog-card-panel:hover) {
    border-color: var(--color-accent);
  }

  .blog-list-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    text-decoration: none;
    color: var(--color-text);
  }

  .post-title {
    font-size: calc(var(--text-lg) * 0.8);
    font-weight: 500;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #3f0766;
  }

  .blog-list-link:hover .post-title {
    filter: brightness(1.2);
  }

  .post-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    flex-shrink: 0;
    font-size: calc(var(--text-sm) * 0.9);
    color: #513664;
  }

  .post-date {
    font-weight: 500;
    color: #513664;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }
  }
</style>
