---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/url';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pagePosts = posts.slice(0, 10);

function formatDate(date: Date) {
  const d = new Date(date);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}.${month}.${day}`;
}
---

<BaseLayout title="Blog" description="♪ 무서운 얘기를 해 줄까">
  <Header />

  <main id="main" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">Blog</h1>
        <p class="page-description">♪ 무서운 얘기를 해 줄까</p>
      </Container>
    </section>

    <section class="section">
      <Container>
        <ul class="blog-list">
          {
            pagePosts.map((post) => (
              <li class="blog-list-item">
                <a href={withBase(`/blog/${post.id}/`)} class="blog-list-link">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-date">{formatDate(post.data.pubDate)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  .page-header {
    text-align: center;
    /* Dreams 페이지와 완전히 동일한 상하 패딩 적용 */
    padding: calc(var(--space-3xl) - 4px) 0 var(--space-xl) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-2xl) 0 var(--space-3xl) 0;
  }

  .conch-list {
    max-width: 42rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .conch-item {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    transition: background var(--transition-fast);
  }

  .conch-item[open] {
    background: var(--color-bg-card);
  }

  .conch-item summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .conch-item summary::-webkit-details-marker {
    display: none;
  }

  .conch-answer {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
