---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection, render } from 'astro:content'

const conchEntries = await getCollection('conch', ({ data }) => !data.draft)

const sortedEntries = [...conchEntries].sort((a, b) => {
  const timeA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
  const timeB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
  return timeA - timeB
})

const conchItems = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry)
    return {
      question: entry.data.title,
      renderContent: Content
    }
  })
)
---

<IndexLayout title={`Conch - ${themeConfig.site.title}`} description="여보세요~">
  <main class="wind-ally-container">
    <div class="wind-ally-wrapper">
      <div style="margin-bottom: 1rem;">
        <h1 style="font-size: 1rem !important; font-weight: 700 !important; margin-bottom: 0.25rem !important;">
          Conch
        </h1>
        <p
          style="font-size: 0.75rem !important; line-height: 1.4; margin: 0 !important;"
          class="text-gray-500 dark:text-gray-400"
        >
          여보세요~
        </p>
      </div>

      <div class="conch-list w-full">
        {
          conchItems.length > 0 ? (
            conchItems.map((item) => (
              <details class="group px-3.5 py-2.5 sm:px-4 sm:py-3 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm transition">
                <summary class="conch-summary font-medium text-gray-900 dark:text-gray-100 select-none">
                  <span class="flex items-center gap-2">{item.question}</span>
                  <span class="arrow-wrap flex items-center">
                    <span class="text-gray-400 transition-transform duration-200 group-open:rotate-90 shrink-0 text-xs">
                      ›
                    </span>
                  </span>
                </summary>
                <div class="mt-3 pt-3 border-t border-gray-100 dark:border-gray-800 text-xs leading-relaxed text-gray-600 dark:text-gray-300">
                  <item.renderContent />
                </div>
              </details>
            ))
          ) : (
            <p class="text-center text-gray-400 py-12 text-xs">
              작성된 노트가 없습니다. src/content/conch 폴더에 마크다운 파일을 추가해보세요!
            </p>
          )
        }
      </div>
    </div>
  </main>
</IndexLayout>

<style>
  .wind-ally-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .wind-ally-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .conch-list {
    font-size: 90%;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* 브라우저 기본 아코디언 삼각형 강제 제거 */
  details > summary {
    list-style: none;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
    cursor: pointer;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::marker {
    display: none;
  }

  .arrow-wrap {
    margin-right: 0.25rem;
  }

  @media (min-width: 640px) {
    .wind-ally-wrapper {
      gap: 1.25rem;
    }
    .arrow-wrap {
      margin-right: 0.5rem;
    }
  }
  .conch-list details {
    transition: all 0.2s ease;
  }

  .conch-list details:hover {
    opacity: 0.85; /* 마우스를 올렸을 때 살짝 투명해지는 효과 */
    /* 혹은 배경색을 바꾸고 싶다면 아래처럼 지정 가능 */
    background: var(--code-bg, rgba(125, 125, 125, 0.05));
  }

  /* 브라우저 기본 아코디언 삼각형 강제 제거 */
  details > summary {
    list-style: none;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
    cursor: pointer;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::marker {
    display: none;
  }

  .arrow-wrap {
    margin-right: 0.25rem;
  }

  @media (min-width: 640px) {
    .wind-ally-wrapper {
      gap: 1.25rem;
    }
    .arrow-wrap {
      margin-right: 0.5rem;
    }
  }
</style>
