---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Faq from '@/components/landing/Faq.astro';
import Container from '@/components/ui/Container.astro';

// Conch 페이지에서 보여줄 토글(질문/답변) 목록 데이터
const conchItems = [
  {
    question: "Conch 메뉴란 무엇인가요?",
    answer: "랜딩 페이지에서 사용하던 아코디언 토글 컴포넌트를 그대로 재사용하여 만든 새로운 Conch 페이지입니다."
  },
  {
    question: "토글은 어떻게 동작하나요?",
    answer: "클릭하면 부드럽게 열리고 닫히며, HTML 표준 details와 summary 태그를 기반으로 작동하여 가볍고 깔끔합니다."
  },
  {
    question: "내용을 수정하려면 어떻게 하나요?",
    answer: "위쪽 conchItems 배열 안에 있는 question과 answer 내용을 원하시는 대로 자유롭게 수정해서 사용하실 수 있습니다."
  }
];
---

<BaseLayout title="Conch" description="Conch 토글 메뉴 페이지입니다.">
  <Header />
  
  <main id="main" tabindex="-1" class="main-content">
    <header class="page-header">
      <Container>
        <h1 class="page-title">Conch</h1>
        <p class="page-description">토글 컴포넌트를 활용한 새로운 공간입니다.</p>
      </Container>
    </header>

    <section class="section">
      <Container>
        <!-- 랜딩 페이지의 토글(Faq) 컴포넌트 재사용 -->
        <Faq items={conchItems} />
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: calc(100vh - 200px);
  }

  .page-header {
    padding: calc(var(--space-3xl) - 4px) 0 var(--space-xl) 0;
    text-align: center;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    /* 블로그 및 Dreams 페이지와 통일감 있는 선명한 그라데이션 적용 */
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-2xl) 0 var(--space-3xl) 0;
  }
</style>