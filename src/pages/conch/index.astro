---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';

// src/content/conch 폴더 안의 마크다운 파일들을 가져옵니다. (초안 draft 제외)
const conchEntries = await getCollection('conch', ({ data }) => !data.draft);

// 마크다운 본문을 HTML로 렌더링하기 위해 각 항목의 rendered 콘텐츠를 변환합니다.
const conchItems = await Promise.all(
  conchEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      question: entry.data.title,
      // Faq 컴포넌트가 문자열이나 HTML 구조를 받을 수 있도록 처리
      // (만약 Faq 컴포넌트 구조상 HTML 렌더링이 필요하면 아래와 같이 전달)
      renderContent: Content,
    };
  }),
);
---

<BaseLayout title="Conch" description="여보세요~">
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <header class="page-header">
      <Container>
        <h1 class="page-title">Conch</h1>
        <p class="page-description">
          옵시디언 노트가 자동으로 토글 목록으로 변환되는 공간입니다.
        </p>
      </Container>
    </header>

    <section class="section">
      <Container>
        <!-- 기존 Faq 컴포넌트 활용 (노트가 없을 때의 안내 문구 추가 가능) -->
        {
          conchItems.length > 0 ? (
            <div class="conch-list">
              {conchItems.map((item) => (
                <details class="conch-item">
                  <summary>{item.question}</summary>
                  <div class="conch-answer">
                    <item.renderContent />
                  </div>
                </details>
              ))}
            </div>
          ) : (
            <p style="text-align: center; color: var(--color-text-muted);">
              작성된 노트가 없습니다. src/content/conch 폴더에 마크다운 파일을
              추가해보세요!
            </p>
          )
        }
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  .page-header {
    text-align: center;
    /* Dreams 페이지와 완전히 동일한 상하 패딩 적용 */
    padding: calc(var(--space-3xl) - 4px) 0 var(--space-xl) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-2xl) 0 var(--space-3xl) 0;
  }

  .conch-list {
    max-width: 42rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .conch-item {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    transition: background var(--transition-fast);
  }

  .conch-item[open] {
    background: var(--color-bg-card);
  }

  .conch-item summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .conch-item summary::-webkit-details-marker {
    display: none;
  }

  .conch-answer {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
