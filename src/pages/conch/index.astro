---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection, render } from 'astro:content'

const conchEntries = await getCollection('conch', ({ data }) => !data.draft)

const sortedEntries = [...conchEntries].sort((a, b) => {
  const timeA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
  const timeB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
  return timeA - timeB
})

const conchItems = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry)
    return {
      question: entry.data.title,
      renderContent: Content
    }
  })
)
---

<IndexLayout title={`Conch - ${themeConfig.site.title}`} description="여보세요~">
  <main>
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-extrabold mb-2">Conch</h1>
      <p class="text-gray-500 dark:text-gray-400 text-sm">여보세요~</p>
    </div>

    <div class="max-w-2xl mx-auto space-y-4">
      {
        conchItems.length > 0 ? (
          conchItems.map((item) => (
            <details class="group p-5 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm transition">
              <summary class="conch-summary font-semibold text-gray-900 dark:text-gray-100 select-none">
                <span class="flex items-center gap-2">{item.question}</span>
                <span class="arrow-wrap pr-4 flex items-center">
                  <span class="text-gray-400 transition-transform duration-200 group-open:rotate-90 shrink-0">›</span>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                <item.renderContent />
              </div>
            </details>
          ))
        ) : (
          <p class="text-center text-gray-400 py-12">
            작성된 노트가 없습니다. src/content/conch 폴더에 마크다운 파일을 추가해보세요!
          </p>
        )
      }
    </div>
  </main>
</IndexLayout>

<style>
  /* 브라우저 기본 아코디언 삼각형 강제 제거 */
  details > summary {
    list-style: none;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
    cursor: pointer;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  details > summary::marker {
    display: none;
  }

  /* margin-right를 주어야 오른쪽 끝에서 왼쪽으로 당겨옵니다 */
  .arrow-wrap {
    margin-right: 15rem; /* 이 값을 키우거나 줄여서 위치를 조절하세요 */
  }
</style>
