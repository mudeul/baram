---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const posts = await getSortedFilteredPosts()

const formattedPosts = posts.map((post) => {
  const data = post.data as any
  return {
    title: data.title || post.id,
    url: `/posts/${post.id}`,
    cover: data.cover || null
  }
})
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <div class="about-section">
    <About />
  </div>

  <main class="wind-ally-container">
    <div class="wind-ally-wrapper">
      <!-- 갤러리 그리드 리스트 (오직 정방형 사진만, 간격 축소) -->
      <div class="gallery-grid">
        {
          formattedPosts.length > 0 ? (
            formattedPosts.map((post) => (
              <a href={post.url} class="gallery-card">
                {post.cover && (
                  <div class="gallery-image-wrap">
                    <img src={post.cover} alt={post.title} loading="lazy" />
                  </div>
                )}
              </a>
            ))
          ) : (
            <p class="text-center text-gray-400 py-12 text-xs" style="grid-column: span 3;">
              작성된 노트가 없습니다. src/content/posts 폴더에 마크다운 파일을 추가해보세요!
            </p>
          )
        }
      </div>
    </div>
  </main>
</IndexLayout>

<style>
  /* about 영역 전체의 글씨 크기를 강제로 축소하고 바깥으로 튀어나가는 것 방지 */
  .about-section {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 0.5rem 1rem;
    box-sizing: border-box;
    word-break: keep-all;
    overflow-wrap: break-word;
    font-size: 0.75rem !important; /* 전체 글씨 크기 확 줄이기 */
  }

  /* 프로즈(prose) 테마가 내부 태그 크기를 덮어쓰지 못하도록 강제 적용 */
  .about-section :global(*) {
    font-size: inherit !important;
    line-height: 1.4 !important;
  }

  .wind-ally-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1rem 1rem 2rem 1rem;
    box-sizing: border-box;
  }

  .wind-ally-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  /* 가로 3개 정방형 그리드, 사진 간격 절반으로 축소 (0.35rem) */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .gallery-card {
    display: block;
    text-decoration: none;
    border-radius: 0.35rem;
    overflow: hidden;
    background: var(--bg-card, #fff);
    border: 1px solid rgba(150, 150, 150, 0.15);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .gallery-card:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  /* 정방형(1:1 비율) 이미지 영역 */
  .gallery-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(125, 125, 125, 0.05);
  }

  .gallery-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-card:hover .gallery-image-wrap img {
    transform: scale(1.03);
  }
</style>
