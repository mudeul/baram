---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const posts = await getSortedFilteredPosts()

const formattedPosts = posts.map((post) => {
  const data = post.data as any
  return {
    title: data.title || post.id,
    url: `/posts/${post.id}`,
    cover: data.cover || null,
    // 👉 클릭 방지 속성 추가 (frontmatter에 disableLink: true 또는 clickable: false가 있을 경우 감지)
    disableLink: data.disableLink === true || data.clickable === false
  }
})
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <div class="about-section">
    <About />
  </div>

  <main class="wind-ally-container">
    <div class="wind-ally-wrapper">
      <!-- 갤러리 그리드 리스트 (오직 정방형 사진만, 간격 축소) -->
      <div class="gallery-grid">
        {
          formattedPosts.length > 0 ? (
            formattedPosts.map((post) =>
              post.disableLink ? (
                // 👉 링크가 비활성화된 경우: <a> 태그 대신 <div>로 렌더링하고 호버 효과 제거 클래스 부여
                <div class="gallery-card gallery-card--disabled">
                  {post.cover && (
                    <div class="gallery-image-wrap">
                      <img src={post.cover} alt={post.title} loading="lazy" />
                    </div>
                  )}
                </div>
              ) : (
                // 👉 기존과 같이 클릭 가능한 경우: <a> 태그 유지
                <a href={post.url} class="gallery-card">
                  {post.cover && (
                    <div class="gallery-image-wrap">
                      <img src={post.cover} alt={post.title} loading="lazy" />
                    </div>
                  )}
                </a>
              )
            )
          ) : (
            <p class="text-center text-gray-400 py-12 text-xs" style="grid-column: span 3;">
              작성된 노트가 없습니다. src/content/posts 폴더에 마크다운 파일을 추가해보세요!
            </p>
          )
        }
      </div>
    </div>
  </main>
</IndexLayout>

<style>
  .about-section {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 0.5rem 1rem;
    box-sizing: border-box;
    word-break: keep-all;
    overflow-wrap: break-word;
    font-size: 1.05rem;
  }

  .wind-ally-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1rem 1rem 2rem 1rem;
    box-sizing: border-box;
  }

  .wind-ally-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }

  .gallery-card {
    display: block;
    text-decoration: none;
    border-radius: 0.35rem;
    overflow: hidden;
    background: var(--bg-card, #fff);
    border: 1px solid rgba(150, 150, 150, 0.15);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  /* 클릭 가능한 카드에만 호버 효과 적용 */
  a.gallery-card:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  /* 👉 클릭이 막힌 카드는 마우스 커서를 기본으로 바꾸고 호버 효과 제거 */
  .gallery-card--disabled {
    cursor: default;
  }

  .gallery-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(125, 125, 125, 0.05);
  }

  .gallery-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  /* 클릭 가능한 카드에만 이미지 확대 효과 적용 */
  a.gallery-card:hover .gallery-image-wrap img {
    transform: scale(1.03);
  }
</style>
