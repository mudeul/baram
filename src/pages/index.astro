---
import BaseLayout from '@/layouts/BaseLayout.astro';
import siteConfig from '@/site.config';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
---

<BaseLayout description="이 바람이 좋아 나를 날려도 좋아 어디로든 갈 수 있다면">
  <Header />

  <main id="main" tabindex="-1">
    <section class="home-hero">
      <Container size="xl">
        <div class="home-hero__meta">
          <span>Astro 7 theme system</span>
          <span>Edition 2026</span>
        </div>
        <h1>
          이 바람이 좋아<br />
          나를 날려도 좋아<br />
          <span>어디로든 갈 수 있다면</span>
        </h1>
        <div class="home-hero__footer">
          <p>
            🌱🐌 잘 안 되지만.. 어쨌든 하긴 하는데, 역시 안 되네... 다시 해
            볼까...? 어떡하지? 못해... 그래도...를 반복하는 사람 🪼🌊
          </p>
        </div>
        <div class="home-hero__orbit" aria-hidden="true">
          <span>겨울</span><span>밤바람</span><span>찬공기</span>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    overflow: clip;
  }

  .home-hero {
    position: relative;
    min-height: min(54rem, calc(100vh - 5rem)); /* fallback */
    min-height: min(54rem, calc(100dvh - 5rem));
    display: grid;
    align-items: center;
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .home-hero__meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--glass-border);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .home-hero h1 {
    position: relative;
    z-index: 1;
    margin-block: clamp(2rem, 6vw, 4rem);
    font-size: clamp(3.4rem, 8.4vw, 7.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .home-hero h1 span {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .home-hero__footer {
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
  }

  .home-hero__footer > p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .home-hero__orbit {
    position: absolute;
    top: 26%;
    right: -4rem;
    width: 24rem;
    height: 24rem;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    animation: slow-spin 24s linear infinite;
    opacity: 0.55;
    will-change: transform;
  }

  .home-hero__orbit::before {
    content: '';
    position: absolute;
    inset: 20%;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
  }

  .home-hero__orbit span {
    position: absolute;
    padding: 0.25rem 0.6rem;
    background: var(--color-bg);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .home-hero__orbit span:nth-child(1) {
    top: 3rem;
    left: 1rem;
  }
  .home-hero__orbit span:nth-child(2) {
    top: 50%;
    right: -1rem;
  }
  .home-hero__orbit span:nth-child(3) {
    bottom: 1rem;
    left: 5rem;
  }

  @keyframes slow-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 768px) {
    .home-hero__orbit {
      opacity: 0.25;
    }
  }

  @media (max-width: 640px) {
    .home-hero__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__orbit {
      animation: none;
    }
  }
</style>
