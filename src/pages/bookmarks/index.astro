---
import { getCollection } from 'astro:content'
import { themeConfig } from '@/config'
import IndexLayout from '@/layouts/IndexLayout.astro'

const bookmarks = await getCollection('bookmarks')

// 최신순 정렬
bookmarks.sort((a, b) => {
  const timeA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
  const timeB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
  return timeB - timeA
})

// 모든 고유 태그 추출
const tagSet = new Set<string>()
for (let i = 0; i < bookmarks.length; i++) {
  const data = bookmarks[i].data as any
  const itemTags = data.tech || data.tags
  if (Array.isArray(itemTags)) {
    for (let j = 0; j < itemTags.length; j++) {
      if (itemTags[j]) tagSet.add(String(itemTags[j]))
    }
  } else if (typeof itemTags === 'string' && itemTags) {
    tagSet.add(itemTags)
  }
}
const allTags = Array.from(tagSet)

// 북마크 데이터 가공 (제목, 링크, 날짜, 태그)
const formattedBookmarks = bookmarks.map((post) => {
  const postData = post.data as any
  const postTags = postData.tech || postData.tags || []
  const tagString = Array.isArray(postTags) ? postTags.join(',') : String(postTags)

  // 날짜 포맷 (YYYY.MM.DD)
  let dateStr = ''
  if (postData.pubDate) {
    const d = new Date(postData.pubDate)
    if (!isNaN(d.getTime())) {
      const year = d.getFullYear()
      const month = String(d.getMonth() + 1).padStart(2, '0')
      const day = String(d.getDate()).padStart(2, '0')
      dateStr = `${year}.${month}.${day}`
    }
  }

  return {
    title: postData.title || post.id,
    url: postData.link || `#`,
    dateStr,
    tagString
  }
})
---

<IndexLayout title={`Bookmarks - ${themeConfig.site.title}`} description="♪ 다만 내 것이 되지 않았어">
  <main style="width: 100%; max-width: 42rem; margin: 0 auto; padding: 2rem 1rem;">
    <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
      <!-- 헤더 -->
      <div style="margin-bottom: 0.25rem;">
        <h1 style="font-size: 1rem !important; font-weight: 700 !important; margin-bottom: 0.25rem !important;">
          Bookmarks
        </h1>
        <p style="font-size: 0.75rem !important; line-height: 1.4;" class="text-gray-500 dark:text-gray-400">
          ♪ 다만 내 것이 되지 않았어
        </p>
      </div>

      <!-- 태그 필터 버튼들 -->
      {
        allTags.length > 0 && (
          <div
            style="display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; margin-top: -0.25rem; margin-bottom: 0.5rem;"
            aria-label="Filter by tag"
          >
            <button
              class="tag-btn active"
              data-tag="all"
              style="background: #eceafa; border: 1px solid #eceafa; color: #555555; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.65rem; cursor: pointer; transition: all 0.2s ease;"
            >
              All
            </button>
            {allTags.map((tag) => (
              <button
                class="tag-btn"
                data-tag={tag}
                style="background: rgba(125, 125, 125, 0.08); border: 1px solid #eaeaea; color: #666666; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.65rem; cursor: pointer; transition: all 0.2s ease;"
              >
                {tag}
              </button>
            ))}
          </div>
        )
      }

      <!-- 직접 렌더링하는 콤팩트 북마크 리스트 -->
      <div class="bookmarks-container">
        {
          formattedBookmarks.map(({ title, url, dateStr, tagString }) => (
            <div class="bookmark-item-row" data-tags={tagString}>
              <a href={url} target="_blank" rel="noopener noreferrer" class="bookmark-link">
                <span class="bookmark-title">{title}</span>
                <span class="bookmark-line" />
                <span class="bookmark-date">{dateStr}</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </main>

  <style>
    /* 전체 리스트 글씨 크기 90% 축소 */
    .bookmarks-container {
      font-size: 90%;
      display: flex;
      flex-direction: column;
      gap: 0.35rem; /* 글제목 사이의 간격 */
    }

    .bookmark-item-row {
      width: 100%;
    }

    /* 한 줄 레이아웃 (제목 - 구분선 - 날짜) */
    .bookmark-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      color: inherit;
      padding: 0.15rem 0; /* 행 자체의 상하 여백을 아주 슬림하게 조절 */
      line-height: 1.2;
    }

    .bookmark-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 65%;
    }

    /* 점선 또는 실선 디자인 (테마 스타일에 맞춤) */
    .bookmark-line {
      flex: 1;
      border-bottom: 1px dashed rgba(150, 150, 150, 0.3);
      height: 0;
    }

    .bookmark-date {
      white-space: nowrap;
      font-size: 0.85em;
      color: #999;
    }

    .bookmark-link:hover .bookmark-title {
      color: var(--color-primary, #6366f1);
      text-decoration: underline;
    }
    /* PostList 내부의 날짜 및 행 요소를 완벽한 수직 가운데 정렬로 강제 고정 */
    .bookmark-item-row :global(.post-item),
    .bookmark-item-row :global(a),
    .bookmark-item-row :global(div) {
      align-items: center !important;
    }
    /* 한 줄 레이아웃 (제목 - 구분선 - 날짜) */
    .bookmark-link {
      display: flex;
      align-items: center; /* 이 부분이 중앙 정렬을 잡아줍니다 */
      gap: 0.5rem;
      text-decoration: none;
      color: inherit;
      padding: 0.15rem 0;
      line-height: 1.2;
    }
  </style>

  <!-- 클라이언트 필터링 스크립트 -->
  <script is:inline>
    function initBookmarksFilter() {
      var buttons = document.querySelectorAll('.tag-btn')
      var rows = document.querySelectorAll('.bookmark-item-row')

      if (buttons.length === 0 || rows.length === 0) return

      for (var i = 0; i < buttons.length; i++) {
        buttons[i].addEventListener('click', function () {
          for (var j = 0; j < buttons.length; j++) {
            buttons[j].classList.remove('active')
            buttons[j].style.background = 'rgba(125, 125, 125, 0.08)'
            buttons[j].style.color = '#666666'
            buttons[j].style.borderColor = '#eaeaea'
          }

          this.classList.add('active')
          this.style.background = '#eceafa'
          this.style.color = '#555555'
          this.style.borderColor = '#eceafa'

          var targetTag = this.getAttribute('data-tag')

          for (var k = 0; k < rows.length; k++) {
            var tagsAttr = rows[k].getAttribute('data-tags') || ''
            var tagsList = tagsAttr.split(',')

            if (targetTag === 'all' || tagsList.indexOf(targetTag) !== -1) {
              rows[k].style.display = ''
            } else {
              rows[k].style.display = 'none'
            }
          }
        })
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBookmarksFilter)
    } else {
      initBookmarksFilter()
    }
    document.addEventListener('astro:page-load', initBookmarksFilter)
  </script>
</IndexLayout>
