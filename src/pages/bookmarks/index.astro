---
export const prerender = true // 👈 이 줄을 추가해주세요!
import { getCollection } from 'astro:content'
import { themeConfig } from '@/config'
import IndexLayout from '@/layouts/IndexLayout.astro'

const bookmarks = await getCollection('bookmarks')

// 최신순 정렬
bookmarks.sort((a, b) => {
  const timeA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
  const timeB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
  return timeB - timeA
})

// 모든 고유 태그 추출
const tagSet = new Set<string>()
for (let i = 0; i < bookmarks.length; i++) {
  const data = bookmarks[i].data as any
  const itemTags = data.tech || data.tags
  if (Array.isArray(itemTags)) {
    for (let j = 0; j < itemTags.length; j++) {
      if (itemTags[j]) tagSet.add(String(itemTags[j]))
    }
  } else if (typeof itemTags === 'string' && itemTags) {
    tagSet.add(itemTags)
  }
}
const allTags = Array.from(tagSet)

// 북마크 데이터 가공 (제목, 링크, 날짜, 태그)
const formattedBookmarks = bookmarks.map((post) => {
  const postData = post.data as any
  const postTags = postData.tech || postData.tags || []
  const tagString = Array.isArray(postTags) ? postTags.join(',') : String(postTags)

  const bookmarkUrl = `/bookmarks/${post.id}`

  let dateStr = ''
  if (postData.pubDate) {
    const d = new Date(postData.pubDate)
    if (!isNaN(d.getTime())) {
      const year = d.getFullYear()
      const month = String(d.getMonth() + 1).padStart(2, '0')
      const day = String(d.getDate()).padStart(2, '0')
      dateStr = `${year}.${month}.${day}`
    }
  }

  return {
    title: postData.title || post.id,
    url: bookmarkUrl,
    dateStr,
    tagString
  }
})
---

<IndexLayout title={`Bookmarks - ${themeConfig.site.title}`} description="♪ 다만 내 것이 되지 않았어">
  <main style="width: 100%; max-width: 42rem; margin: 0 auto; padding: 2rem 0rem;">
    <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
      <!-- 헤더 -->
      <div style="margin-bottom: 1.5rem;">
        <h1 style="font-size: 1rem !important; font-weight: 700 !important; margin-bottom: 0.25rem !important;">
          Bookmarks
        </h1>
        <p
          style="font-size: 0.75rem !important; line-height: 1.4; margin: 0 !important;"
          class="text-gray-500 dark:text-gray-400"
        >
          ♪ 다만 내 것이 되지 않았어
        </p>
      </div>

      <!-- 태그 필터 버튼들 -->
      {
        allTags.length > 0 && (
          <div
            style="display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; margin-top: -0.25rem; margin-bottom: 0.5rem;"
            aria-label="Filter by tag"
          >
            <button
              class="tag-btn active"
              data-tag="all"
              style="background: var(--mark); border: 1px solid var(--mark); color: #555555; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.65rem; cursor: pointer; transition: all 0.2s ease;"
            >
              All
            </button>
            {allTags.map((tag) => (
              <button
                class="tag-btn"
                data-tag={tag}
                style="background: rgba(125, 125, 125, 0.08); border: 1px solid #eaeaea; color: #666666; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.65rem; cursor: pointer; transition: all 0.2s ease;"
              >
                {tag}
              </button>
            ))}
          </div>
        )
      }

      <!-- 북마크 리스트 -->
      <div class="bookmarks-container">
        {
          formattedBookmarks.map(({ title, url, dateStr, tagString }, index) => (
            <div class="bookmark-item-row" data-tags={tagString} data-index={index}>
              <a href={url} class="bookmark-link">
                <span class="bookmark-title">{title}</span>
                <span class="bookmark-line" />
                <span class="bookmark-date">{dateStr}</span>
              </a>
            </div>
          ))
        }
      </div>

      <!-- 더보기 버튼 -->
      <div id="load-more-container" style="display: flex; justify-content: center; margin-top: 1rem;">
        <button
          id="load-more-btn"
          style="background: rgba(125, 125, 125, 0.08); border: 1px solid #eaeaea; color: #666666; padding: 0.4rem 1.2rem; border-radius: 9999px; font-size: 0.75rem; cursor: pointer; transition: all 0.2s ease;"
        >
          더보기
        </button>
      </div>
    </div>
  </main>

  <style>
    .bookmarks-container {
      font-size: 90%;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .bookmark-item-row {
      width: 100%;
    }

    .bookmark-link {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      text-decoration: none;
      color: inherit;
      padding: 0.15rem 0;
      line-height: 1.2;
    }

    .bookmark-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 65%;
    }

    .bookmark-line {
      flex: 1;
      border-bottom: 1px dashed rgba(150, 150, 150, 0.3);
      height: 0;
      position: relative;
      top: -3px;
    }

    .bookmark-date {
      white-space: nowrap;
      font-size: 0.85em;
      color: #999;
    }

    .bookmark-link:hover .bookmark-title {
      color: inherit;
      text-decoration: none;
    }

    .bookmark-link:hover {
      opacity: 0.8;
    }

    #load-more-btn:hover {
      background: var(--mark);
      color: #555555;
      border-color: var(--mark);
    }

    .tag-btn.active {
      background: var(--mark) !important;
      border-color: var(--mark) !important;
      color: #555555 !important;
    }
  </style>

  <script is:inline>
    var pageSize = 20
    var currentVisibleCount = pageSize
    var activeTag = 'all'

    function updateBookmarksView() {
      var rows = document.querySelectorAll('.bookmark-item-row')
      var loadMoreContainer = document.getElementById('load-more-container')

      var matchedCount = 0
      var shownCount = 0

      for (var k = 0; k < rows.length; k++) {
        var tagsAttr = rows[k].getAttribute('data-tags') || ''
        var tagsList = tagsAttr.split(',')

        var matchesTag = activeTag === 'all' || tagsList.indexOf(activeTag) !== -1

        if (matchesTag) {
          matchedCount++
          if (matchedCount <= currentVisibleCount) {
            rows[k].style.display = ''
            shownCount++
          } else {
            rows[k].style.display = 'none'
          }
        } else {
          rows[k].style.display = 'none'
        }
      }

      if (loadMoreContainer) {
        if (shownCount < matchedCount) {
          loadMoreContainer.style.display = 'flex'
        } else {
          loadMoreContainer.style.display = 'none'
        }
      }
    }

    function initBookmarks() {
      var buttons = document.querySelectorAll('.tag-btn')
      var loadMoreBtn = document.getElementById('load-more-btn')

      if (buttons.length === 0) return

      for (var i = 0; i < buttons.length; i++) {
        buttons[i].addEventListener('click', function () {
          for (var j = 0; j < buttons.length; j++) {
            buttons[j].classList.remove('active')
            buttons[j].style.background = 'rgba(125, 125, 125, 0.08)'
            buttons[j].style.color = '#666666'
            buttons[j].style.borderColor = '#eaeaea'
          }

          this.classList.add('active')
          this.style.background = 'var(--mark)'
          this.style.color = '#555555'
          this.style.borderColor = 'var(--mark)'

          activeTag = this.getAttribute('data-tag') || 'all'
          currentVisibleCount = pageSize
          updateBookmarksView()
        })
      }

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function () {
          currentVisibleCount += pageSize
          updateBookmarksView()
        })
      }

      updateBookmarksView()
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBookmarks)
    } else {
      initBookmarks()
    }
    document.addEventListener('astro:page-load', initBookmarks)
  </script>
</IndexLayout>
