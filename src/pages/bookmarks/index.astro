---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/url';

const bookmarks = (await getCollection('bookmarks')).sort(
  (a, b) =>
    new Date(b.data.pubDate ?? 0).valueOf() -
    new Date(a.data.pubDate ?? 0).valueOf(),
);

const pageBookmarks = bookmarks.slice(0, 5);
const hasNextPage = bookmarks.length > 5;
---

<BaseLayout title="Bookmarks" description="♪ 다만 내 것이 되지 않았어">
  <Header />

  <main id="main" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">Bookmarks</h1>
        <p class="page-description">♪ 다만 내 것이 되지 않았어</p>
      </Container>
    </section>

    <section class="section">
      <Container>
        <ul class="bookmark-list">
          {
            pageBookmarks.map((bookmark) => (
              <li class="bookmark-list-item">
                <a
                  href={withBase(`/bookmarks/${bookmark.id}/`)}
                  class="bookmark-list-link"
                >
                  <span class="post-title">{bookmark.data.title}</span>
                  <div class="post-meta">
                    {bookmark.data.author && (
                      <span class="post-author">{bookmark.data.author}</span>
                    )}
                  </div>
                </a>
              </li>
            ))
          }
        </ul>

        <nav class="pagination" aria-label="Pagination">
          <span class="page-btn disabled">&larr; Prev</span>
          <span class="page-info">1 / {Math.ceil(bookmarks.length / 5)}</span>
          {
            hasNextPage ? (
              <a href={withBase('/bookmarks/page/2/')} class="page-btn">
                Next &rarr;
              </a>
            ) : (
              <span class="page-btn disabled">Next &rarr;</span>
            )
          }
        </nav>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  .page-header {
    text-align: center;
    padding: calc(var(--space-3xl) - 4px) 0 var(--space-xl) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .section {
    padding: var(--space-2xl) 0 var(--space-3xl) 0;
  }

  /* 다른 페이지들과 동일하게 34rem 및 일관된 패딩 적용 */
  :global(.section .container),
  :global(.page-header .container) {
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .bookmark-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
  }

  .bookmark-list-item {
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: var(--space-md);
  }

  .bookmark-list-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .post-title {
    font-size: calc(var(--text-lg) * 0.8);
    font-weight: 500;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #3f0766;
  }

  .bookmark-list-link:hover .post-title {
    filter: brightness(1.2);
  }

  .post-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    flex-shrink: 0;
    font-size: calc(var(--text-sm) * 0.9);
    color: #513664;
  }

  .post-author {
    font-weight: 500;
    color: #513664;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    max-width: 34rem;
    margin-inline: auto;
  }

  .page-btn {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .page-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .page-info {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }
    .bookmark-list-link {
      flex-direction: row;
    }
  }
</style>
