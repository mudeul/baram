---
import type { GetStaticPaths, Page } from 'astro'
import IndexLayout from '@/layouts/IndexLayout.astro'
import PostList from '@/components/widgets/PostList.astro'
import { themeConfig } from '@/config'
import { getCollection, type CollectionEntry } from 'astro:content'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection('bookmarks')
  const sortedPosts = posts
    .sort((a, b) => {
      const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
      const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
      return dateB - dateA
    })
    .map((post) => ({
      ...post,
      id: `bookmarks/${post.id}`
    }))

  return paginate(sortedPosts, { pageSize: 10 })
}

type BookmarkEntry = CollectionEntry<'bookmarks'> & { id: string }

interface Props {
  page: Page<BookmarkEntry>
}

const { page } = Astro.props
---

<IndexLayout
  title={`Bookmarks (Page ${page.currentPage}) - ${themeConfig.site.title}`}
  description={themeConfig.site.description}
>
  <main>
    <div class="mb-6">
      <h1 class="text-xl font-bold mb-2">Bookmarks</h1>
    </div>

    <PostList posts={page.data} />

    <div style="width: 100%; display: flex; justify-content: center; margin-top: -1rem; margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 2rem; font-size: 0.875rem;">
        {
          page.url.prev ? (
            <a
              href={page.url.prev}
              style="font-weight: 500; transition: opacity 0.2s;"
              class="no-visited hover:opacity-75 text-gray-900 dark:text-gray-100"
            >
              ← 이전
            </a>
          ) : (
            <span style="color: #d1d5db; cursor: not-allowed;">← 이전</span>
          )
        }

        <span style="color: #4b5563; font-weight: 500;">
          {page.currentPage} / {page.lastPage}
        </span>

        {
          page.url.next ? (
            <a
              href={page.url.next}
              style="font-weight: 500; transition: opacity 0.2s;"
              class="no-visited hover:opacity-75 text-gray-900 dark:text-gray-100"
            >
              다음 →
            </a>
          ) : (
            <span style="color: #d1d5db; cursor: not-allowed;">다음 →</span>
          )
        }
      </div>
    </div>
  </main>
</IndexLayout>

<style>
  .no-visited:visited {
    color: currentColor !important;
  }
</style>
