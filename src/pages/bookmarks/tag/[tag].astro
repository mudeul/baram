---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/url';

export async function getStaticPaths() {
  const bookmarks = await getCollection('bookmarks');
  const allTags = [
    ...new Set(bookmarks.flatMap((bookmark) => bookmark.data.tags || [])),
  ];

  return allTags.map((tag) => {
    const filteredBookmarks = bookmarks
      .filter((bookmark) => bookmark.data.tags?.includes(tag))
      .sort(
        (a, b) =>
          new Date(b.data.pubDate ?? 0).valueOf() -
          new Date(a.data.pubDate ?? 0).valueOf(),
      );

    return {
      params: { tag },
      props: { tag, bookmarks: filteredBookmarks },
    };
  });
}

const { tag, bookmarks } = Astro.props;

// 전체 태그 목록 (상단 필터 칩용)
const allBookmarks = await getCollection('bookmarks');
const allTags = Array.from(
  new Set(allBookmarks.flatMap((bookmark) => bookmark.data.tags || [])),
).sort();
---

<BaseLayout
  title={`Bookmarks: #${tag}`}
  description={`#${tag} 태그가 포함된 북마크 목록`}
>
  <Header />

  <main id="main" class="main-content">
    <section class="page-header">
      <Container>
        <h1 class="page-title">#{tag}</h1>
        <p class="page-description">관련 북마크 모음</p>
      </Container>
    </section>

    <section class="section">
      <Container>
        {/* 태그 카테고리 목록 */}
        {
          allTags.length > 0 && (
            <div class="bookmark-tags-filter">
              <a href={withBase('/bookmarks/')} class="tag-chip">
                All
              </a>
              {allTags.map((t) => (
                <a
                  href={withBase(`/bookmarks/tag/${t}/`)}
                  class={`tag-chip ${t === tag ? 'active' : ''}`}
                >
                  {t}
                </a>
              ))}
            </div>
          )
        }

        <GlassPanel
          variant="translucent"
          padding="xl"
          className="list-container-panel"
        >
          <ul class="bookmark-list">
            {
              bookmarks.map((bookmark) => (
                <li class="bookmark-list-item">
                  <a
                    href={withBase(`/bookmarks/${bookmark.id}/`)}
                    class="bookmark-list-link"
                  >
                    <span class="post-title">{bookmark.data.title}</span>
                    <div class="post-meta">
                      {bookmark.data.author && (
                        <span class="post-author">{bookmark.data.author}</span>
                      )}
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </GlassPanel>
      </Container>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  /* 메인 페이지와 동일한 넉넉한 하단 패딩 적용 */
  .page-header {
    text-align: center;
    padding: var(--space-3xl) 0 var(--space-xl) 0;
    margin-bottom: 0;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin-bottom: 0;
  }

  .section {
    padding: 0 0 var(--space-3xl) 0;
  }

  :global(.section .container),
  :global(.page-header .container) {
    max-width: 38rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .bookmark-tags-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem var(--space-md);
    font-size: calc(var(--text-xs) * 1.1);
    font-weight: 500;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
    line-height: 1.2;
  }

  .tag-chip:hover,
  .tag-chip.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-surface-hover, var(--color-surface));
  }

  .bookmark-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
  }

  .bookmark-list-item {
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: var(--space-md);
  }

  .bookmark-list-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .bookmark-list-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    text-decoration: none;
    color: var(--color-text);
  }

  .post-title {
    font-size: calc(var(--text-lg) * 0.85);
    font-weight: 500;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #3f0766;
  }

  .bookmark-list-link:hover .post-title {
    filter: brightness(1.2);
  }

  .post-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    flex-shrink: 0;
    font-size: calc(var(--text-sm) * 0.9);
    color: #513664;
  }

  .post-author {
    font-weight: 500;
    color: #513664;
  }
</style>
