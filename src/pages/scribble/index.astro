---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import { withBase } from '@/lib/url';

// scribble 컬렉션 가져오기 및 최신순 정렬
const scribbles = (
  await getCollection('scribble', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);
---

<BaseLayout title="Scribble — 높이 부는 바람" description="끄적끄적">
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">Scribble</h1>
        <p class="page-description">끄적끄적</p>
      </div>
    </section>

    <div class="container">
      <div class="portfolio-wrapper">
        {/* 인스타그램 스타일 3열 사진 그리드 (오직 사진만 꽉 차게) */}
        <div class="portfolio-grid">
          {
            scribbles.map((item) => (
              <a
                href={withBase(`/scribble/${item.id}/`)}
                class="portfolio-item"
              >
                {item.data.cover ? (
                  <img
                    src={item.data.cover}
                    alt={
                      item.data.coverAlt || item.data.title || 'Scribble image'
                    }
                    loading="lazy"
                    class="portfolio-img"
                  />
                ) : (
                  <div class="portfolio-placeholder">
                    <span>{item.data.title || 'No Image'}</span>
                  </div>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
    padding: 0;
  }

  .page-header {
    text-align: center;
    padding: var(--space-3xl) 0 var(--space-xs) 0;
    margin-bottom: 0;
  }

  .container {
    max-width: 39rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    margin-bottom: var(--space-sm);
    background: linear-gradient(
      135deg,
      var(--color-text),
      var(--color-accent-dark)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .portfolio-wrapper {
    width: 100%;
    margin-inline: auto;
    padding-top: var(--space-md);
    padding-bottom: var(--space-3xl);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xs);
  }

  .portfolio-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.25rem;
    background-color: var(--color-surface);
    display: block;
  }

  .portfolio-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .portfolio-item:hover .portfolio-img {
    transform: scale(1.02);
    filter: brightness(0.95);
  }

  .portfolio-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-xs);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
    }
  }
</style>
