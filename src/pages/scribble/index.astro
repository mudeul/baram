---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection } from 'astro:content'

const scribbles = await getCollection('scribble')

// 날짜 최신순 정렬
scribbles.sort((a, b) => {
  const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
  const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
  return dateB - dateA
})
---

<IndexLayout title={`Scribble - ${themeConfig.site.title}`} description="끄적끄적">
  <main class="scribble-container">
    <div class="scribble-grid">
      {
        scribbles.map((item) => {
          // scribble 파일은 cover 필드를 사용하므로 이를 우선적으로 가져옵니다
          const coverImage = item.data.cover || item.data.image
          return (
            <a href={`/scribble/${item.id}/`} class="scribble-item">
              {coverImage ? (
                <img src={coverImage} alt={item.data.title || 'Scribble image'} loading="lazy" class="scribble-img" />
              ) : (
                <div class="scribble-placeholder">
                  <span>{item.data.title || 'No Image'}</span>
                </div>
              )}
            </a>
          )
        })
      }
    </div>
  </main>
</IndexLayout>

<style>
  .scribble-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .scribble-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px; /* 기존 8px에서 3px로 축소 */
  }

  .scribble-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px; /* 모서리 둥글기도 살짝 줄이면 더 깔끔합니다 */
    background-color: var(--color-surface, rgba(125, 125, 125, 0.1));
    display: block;
    transition: opacity 0.2s ease;
  }

  .scribble-item:hover {
    opacity: 0.85;
  }

  .scribble-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .scribble-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-text-muted, #666);
    text-align: center;
    padding: 4px;
    word-break: keep-all;
  }

  @media (max-width: 640px) {
    .scribble-grid {
      gap: 2px; /* 모바일에서도 더 촘촘하게 */
    }
  }
</style>
