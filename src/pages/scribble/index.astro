---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection } from 'astro:content'

const scribbles = await getCollection('scribble')

// 날짜 최신순 정렬
scribbles.sort((a, b) => {
  const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
  const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
  return dateB - dateA
})
---

<IndexLayout title={`Scribble - ${themeConfig.site.title}`} description="끄적끄적">
  <main class="scribble-container">
    <div class="scribble-wrapper">
      <div style="margin-bottom: 1rem;">
        <h1 style="font-size: 1rem !important; font-weight: 700 !important; margin-bottom: 0.25rem !important;">
          Scribble
        </h1>
        <p
          style="font-size: 0.75rem !important; line-height: 1.4; margin: 0 !important;"
          class="text-gray-500 dark:text-gray-400"
        >
          끄적끄적
        </p>
      </div>

      <div class="scribble-grid">
        {
          scribbles.map((item) => {
            const coverImage = item.data.cover || item.data.image
            return (
              <a href={`/scribble/${item.id}/`} class="scribble-item">
                {coverImage ? (
                  <img src={coverImage} alt={item.data.title || 'Scribble image'} loading="lazy" class="scribble-img" />
                ) : (
                  <div class="scribble-placeholder">
                    <span>{item.data.title || 'No Image'}</span>
                  </div>
                )}
              </a>
            )
          })
        }
      </div>
    </div>
  </main>
</IndexLayout>

<style>
  .scribble-container {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 0rem;
  }

  .scribble-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .scribble-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    margin-top: 1rem;
  }

  .scribble-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 2px;
    background-color: var(--color-surface, rgba(125, 125, 125, 0.1));
    display: block;
    transition: opacity 0.2s ease;
  }

  .scribble-item:hover {
    opacity: 0.85;
  }

  .scribble-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .scribble-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-text-muted, #666);
    text-align: center;
    padding: 4px;
    word-break: keep-all;
  }

  @media (max-width: 640px) {
    .scribble-grid {
      gap: 2px;
    }
  }
</style>
