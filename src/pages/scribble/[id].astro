---
import IndexLayout from '../../layouts/IndexLayout.astro'
import { themeConfig } from '../../config'
import { getCollection, render } from 'astro:content'
import BackButton from '@/components/ui/BackButton.astro' // 👉 블로그에서 쓰던 백버튼 컴포넌트 불러오기

export async function getStaticPaths() {
  const projects = await getCollection('scribble')
  return projects.map((item) => ({
    params: { id: item.id },
    props: { item }
  }))
}

const { item } = Astro.props
const { Content } = await render(item)

const title = item.data.title ? `${item.data.title} - Scribble` : `Scribble - ${themeConfig.site.title}`
const description = item.data.description || 'Scribble 상세 페이지'
---

<IndexLayout title={title} description={description}>
  <main class="scribble-detail-container">
    <!-- 👉 요기에 href="/scribble/" 를 추가해 주세요! -->
    <BackButton href="/scribble/" />

    <article class="scribble-article">
      <article class="scribble-article">
        <header class="article-header">
          <h1 class="article-title">{item.data.title || 'Untitled'}</h1>
          {
            item.data.pubDate && (
              <time class="article-date" datetime={new Date(item.data.pubDate).toISOString()}>
                {new Date(item.data.pubDate).toLocaleDateString('ko-KR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            )
          }
        </header>

        <!-- 커버 이미지 영역 의도적 제외 -->

        <div class="article-content prose">
          <Content />
        </div>
      </article>
    </article>
  </main>

  <style>
    .scribble-detail-container {
      width: 100%;
      max-width: 42rem;
      margin: 0 auto;
      padding: 2rem 1rem;
      position: relative;
    }

    .scribble-article {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .article-header {
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .article-title {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text, #111);
    }

    .article-date {
      font-size: 0.85rem;
      color: var(--color-text-muted, #666);
    }

    .article-content {
      line-height: 1.7;
      color: var(--color-text, #222);
      word-break: keep-all;
    }
  </style>

  <style is:global>
    .article-content img {
      max-width: 100% !important;
      width: 100% !important;
      height: auto !important;
      display: block !important;
      margin: 1.5rem auto !important;
      border-radius: 4px;
      object-fit: contain;
    }

    .article-content figcaption,
    .article-content .image-caption,
    .article-content alt {
      display: none !important;
    }
  </style></IndexLayout
>
