---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const scribbles = await getCollection('scribble');
  return scribbles.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout
  title={`${item.data.title || 'Scribble'} — 높이 부는 바람`}
  description={item.data.description}
>
  <Header />

  <main id="main" class="main-content">
    <article class="scribble-article">
      <Container size="sm">
        <div class="scribble-header">
          {
            item.data.pubDate && (
              <time
                datetime={item.data.pubDate.toISOString()}
                class="scribble-date"
              >
                {item.data.pubDate.toLocaleDateString('ko-KR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            )
          }
          {item.data.title && <h1 class="scribble-title">{item.data.title}</h1>}
        </div>

        {/* 상세 페이지 상단 커버 이미지 영역 제거 완료 */}

        <GlassPanel variant="translucent" className="scribble-content-box">
          <div class="prose">
            <Content />
          </div>
        </GlassPanel>
      </Container>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    padding: var(--space-3xl) 0;
    min-height: 100vh;
  }

  .scribble-header {
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .scribble-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    display: block;
    margin-bottom: var(--space-xs);
  }

  .scribble-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-text);
  }

  :global(.scribble-content-box) {
    padding: var(--space-xl);
  }

  .prose {
    white-space: pre-wrap;
    word-break: keep-all;
    font-size: var(--text-sm); /* 기존보다 작은 크기(sm)로 강제 조정 */
    line-height: 1.7;
    color: var(--color-text);
  }

  /* 👇 마크다운 본문 안의 문단(p)이나 텍스트들도 확실하게 작은 크기로 고정 */
  .prose :global(p),
  .prose :global(span),
  .prose :global(li) {
    font-size: var(--text-sm) !important;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-md) auto;
    border-radius: var(--radius-md);
  }
</style>
