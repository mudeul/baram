---
// 1. 쿠키 검사 및 인증 상태 확인
const authCookie = Astro.cookies.get('bodong_auth')
let isAuthenticated = authCookie?.value === 'true'
let errorMessage = ''

// 2. 비밀번호를 입력해서 POST 요청을 보낸 경우 처리
if (!isAuthenticated && Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData()
    const inputPassword = data.get('password')
    const CORRECT_PASSWORD = process.env.PASSWORD

    if (inputPassword === CORRECT_PASSWORD) {
      Astro.cookies.set('bodong_auth', 'true', {
        path: '/',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 86400
      })
      return Astro.redirect('/bodong', 303)
    } else {
      errorMessage = '비밀번호가 올바르지 않습니다.'
    }
  } catch (e) {
    errorMessage = '오류가 발생했습니다.'
  }
}

// 3. 인증 완료 시에만 게시글 데이터 로드
let posts = []
let formattedPosts = []

if (isAuthenticated) {
  import { getCollection } from 'astro:content'
  posts = await getCollection('bodong')

  posts.sort((a, b) => {
    const timeA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0
    const timeB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0
    return timeB - timeA
  })

  formattedPosts = posts.map((post) => {
    const postData = post.data as any
    const postUrl = `/bodong/${post.id}`

    let dateStr = ''
    if (postData.pubDate) {
      const d = new Date(postData.pubDate)
      if (!isNaN(d.getTime())) {
        const year = d.getFullYear()
        const month = String(d.getMonth() + 1).padStart(2, '0')
        const day = String(d.getDate()).padStart(2, '0')
        dateStr = `${year}.${month}.${day}`
      }
    }

    return {
      title: postData.title || post.id,
      url: postUrl,
      dateStr
    }
  })
}

import { themeConfig } from '@/config'
import IndexLayout from '@/layouts/IndexLayout.astro'
---

<IndexLayout title={`Bodong - ${themeConfig.site.title}`} description={themeConfig.site.description}>
  <main style="width: 100%; max-width: 42rem; margin: 0 auto; padding: 2rem 0rem;">
    {
      !isAuthenticated ? (
        /* 로그인 안 되었을 때 보여줄 비밀번호 입력 박스 */
        <div class="login-wrapper">
          <div class="box">
            <h2>🔒 BODONG</h2>
            <p>비밀공간입니다. 암호를 입력해주세요.</p>
            {errorMessage && <div class="error">{errorMessage}</div>}
            <form method="POST">
              <input type="password" name="password" placeholder="Password" required autofocus />
              <button type="submit">입장하기</button>
            </form>
          </div>
        </div>
      ) : (
        /* 인증 완료 시 보여줄 원래 게시판 내용 */
        <div style="display: flex; flex-direction: column; gap: 1rem; width: 100%;">
          <div style="margin-bottom: 1rem;">
            <h1 style="font-size: 1rem !important; font-weight: 700 !important; margin-bottom: 0.25rem !important;">
              Bodong
            </h1>
            <p
              style="font-size: 0.75rem !important; line-height: 1.4; margin: 0 !important;"
              class="text-gray-500 dark:text-gray-400"
            >
              보드게임동호회
            </p>
          </div>

          <div class="bodong-container">
            {formattedPosts.map(({ title, url, dateStr }, index) => (
              <div class="bodong-item-row" data-index={index}>
                <a href={url} class="bodong-link">
                  <span class="bodong-title">{title}</span>
                  <span class="bodong-line" />
                  <span class="bodong-date">{dateStr}</span>
                </a>
              </div>
            ))}
          </div>

          <div id="load-more-container" style="display: flex; justify-content: center; margin-top: 1rem;">
            <button
              id="load-more-btn"
              style="background: rgba(125, 125, 125, 0.08); border: 1px solid #eaeaea; color: #666666; padding: 0.4rem 1.2rem; border-radius: 9999px; font-size: 0.75rem; cursor: pointer; transition: all 0.2s ease;"
            >
              더보기
            </button>
          </div>
        </div>
      )
    }
  </main>

  <style>
    /* 로그인 박스 스타일 */
    .login-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 50vh;
    }
    .box {
      background: #ffffff;
      padding: 2.5rem;
      border-radius: 1rem;
      box-shadow:
        0 10px 30px rgba(176, 160, 176, 0.1),
        0 1px 3px rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(176, 160, 176, 0.2);
      text-align: center;
      width: 90%;
      max-width: 360px;
      box-sizing: border-box;
    }
    .box h2 {
      margin-top: 0;
      margin-bottom: 0.5rem;
      font-size: 1.4rem;
      color: #b4addf;
      letter-spacing: -0.025em;
    }
    .box p {
      color: #b0a0b0;
      opacity: 0.85;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }
    .box input[type='password'] {
      width: 100%;
      padding: 0.75rem;
      border-radius: 0.5rem;
      border: 1px solid rgba(176, 160, 176, 0.3);
      background: #f9f5f5;
      color: #b0a0b0;
      font-size: 1rem;
      box-sizing: border-box;
      margin-bottom: 1rem;
      outline: none;
      -webkit-appearance: none;
    }
    .box input[type='password']:focus {
      border-color: #b4addf;
      box-shadow: 0 0 0 3px rgba(180, 173, 223, 0.25);
    }
    .box .error {
      color: #e57373;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }
    .box button[type='submit'] {
      width: 100%;
      padding: 0.75rem;
      border-radius: 0.5rem;
      border: none;
      background: #b4addf;
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 500;
      cursor: pointer;
    }
    .box button[type='submit']:hover {
      opacity: 0.85;
    }

    /* 기존 게시판 스타일 */
    .bodong-container {
      font-size: 90%;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .bodong-item-row {
      width: 100%;
    }
    .bodong-link {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      text-decoration: none;
      color: inherit;
      padding: 0.15rem 0;
      line-height: 1.2;
    }
    .bodong-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 65%;
    }
    .bodong-line {
      flex: 1;
      border-bottom: 1px dashed rgba(150, 150, 150, 0.3);
      height: 0;
      position: relative;
      top: -3px;
    }
    .bodong-date {
      white-space: nowrap;
      font-size: 0.85em;
      color: #999;
    }
    .bodong-link:hover .bodong-title {
      color: inherit;
      text-decoration: none;
    }
    .bodong-link:hover {
      opacity: 0.8;
    }
    #load-more-btn:hover {
      background: #eceafa;
      color: #555555;
      border-color: #eceafa;
    }
  </style>

  <!-- 더보기 스크립트 -->
  <script is:inline>
    var pageSize = 20
    var currentVisibleCount = pageSize

    function updateBodongView() {
      var rows = document.querySelectorAll('.bodong-item-row')
      var loadMoreContainer = document.getElementById('load-more-container')
      var shownCount = 0

      for (var k = 0; k < rows.length; k++) {
        if (k < currentVisibleCount) {
          rows[k].style.display = ''
          shownCount++
        } else {
          rows[k].style.display = 'none'
        }
      }

      if (loadMoreContainer) {
        if (shownCount < rows.length) {
          loadMoreContainer.style.display = 'flex'
        } else {
          loadMoreContainer.style.display = 'none'
        }
      }
    }

    function initBodong() {
      var loadMoreBtn = document.getElementById('load-more-btn')

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function () {
          currentVisibleCount += pageSize
          updateBodongView()
        })
      }

      updateBodongView()
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBodong)
    } else {
      initBodong()
    }
    document.addEventListener('astro:page-load', initBodong)
  </script>
</IndexLayout>
