---
import { render, getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Tag from '@/components/ui/Tag.astro';
import Toc from '@/components/blog/Toc.astro';
import { withBase } from '@/lib/url';
import Comments from '../../components/common/Comments.astro';
import siteConfig from '@/site.config';

export const getStaticPaths = (async () => {
  const posts = await getCollection('bodong');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 작성일 포맷팅 (YYYY.MM.DD)
const pubDate = post.data.pubDate;
const pubYear = pubDate.getFullYear();
const pubMonth = String(pubDate.getMonth() + 1).padStart(2, '0');
const pubDay = String(pubDate.getDate()).padStart(2, '0');
const formattedDate = `${pubYear}.${pubMonth}.${pubDay}`;

// 수정일 포맷팅 (존재하는 경우 YYYY.MM.DD)
let updatedDate: string | undefined = undefined;
if (post.data.updatedDate) {
  const upDate = post.data.updatedDate;
  const upYear = upDate.getFullYear();
  const upMonth = String(upDate.getMonth() + 1).padStart(2, '0');
  const upDay = String(upDate.getDate()).padStart(2, '0');
  updatedDate = `${upYear}.${upMonth}.${upDay}`;
}

const showToc = siteConfig.blog.showToc && headings.length > 0;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={withBase(`/og/bodong/${post.id}.png`)}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: post.data.updatedDate?.toISOString(),
    author: '보동',
    tags: post.data.tags,
  }}
>
  <Header />

  <main id="main" tabindex="-1" class="main-content">
    <article class="blog-post">
      <!-- 1. 타이틀 영역 컨테이너 -->
      <div class="container container--narrow">
        <GlassPanel variant="solid" padding="xl" className="post-header">
          <a href={withBase('/bodong/')} class="post-back">← 뒤로</a>
          <h1 class="post-title">{post.data.title}</h1>

          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}
              >{formattedDate}</time
            >
            {
              updatedDate && (
                <>
                  <span class="separator" aria-hidden="true">
                    ·
                  </span>
                  <span>Updated {updatedDate}</span>
                </>
              )
            }
          </div>

          {
            post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag: string) => (
                  <Tag name={tag} />
                ))}
              </div>
            )
          }
        </GlassPanel>
      </div>

      <!-- 2. 본문 영역 컨테이너 -->
      <div
        class={`container container--wide post-body ${showToc ? 'post-body--with-toc' : ''}`}
      >
        <GlassPanel variant="solid" padding="xl" className="post-content">
          <div class="prose">
            <Content />
          </div>
        </GlassPanel>

        {
          showToc && (
            <aside class="post-toc">
              <div class="post-toc__inner">
                <Toc headings={headings} />
              </div>
            </aside>
          )
        }
      </div>

      <!-- 3. 하단 댓글창 -->
      <div class="container container--narrow">
        <Comments />
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    min-height: 100vh;
    min-height: 100dvh;
  }

  .blog-post {
    padding: var(--space-2xl) 0;
  }

  .container--narrow {
    max-width: 41rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .container--wide {
    max-width: 41rem;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .post-back {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-bottom: var(--space-md);
    transition: color var(--transition-fast);
    align-self: flex-start;
  }
  .post-back:hover {
    color: var(--color-accent);
  }

  .post-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .post-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: var(--space-lg);
    text-align: center;
    /* 다크모드에서도 텍스트가 잘 보이도록 테마 변수 기반 그라데이션 적용 */
    background: linear-gradient(135deg, var(--color-text), var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .separator {
    opacity: 0.5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .post-body {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-2xl);
  }

  .post-body--with-toc {
    grid-template-columns: minmax(0, 1fr) 16rem;
  }

  .post-body :global(.glass-panel.post-content) {
    max-width: 41rem;
    margin-inline: auto;
    width: 100%;
  }

  .post-toc__inner {
    position: sticky;
    top: calc(var(--space-3xl) + var(--space-md));
  }

  .prose {
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: 44rem;
    text-align: justify;
    word-break: keep-all;
    color: var(--color-text);
  }

  .prose :global(:is(h2, h3, h4)) {
    scroll-margin-top: var(--space-3xl);
  }

  @media (max-width: 900px) {
    .post-body--with-toc {
      grid-template-columns: 1fr;
    }
    .post-toc {
      order: -1;
    }
    .post-toc__inner {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: var(--text-3xl);
    }
    .post-meta {
      font-size: var(--text-xs);
    }
    .blog-post {
      padding: var(--space-md) 0;
    }
    .container--narrow,
    .container--wide {
      padding-inline: var(--space-md);
    }
  }
</style>
