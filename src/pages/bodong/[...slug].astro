---
export const prerender = true // 👈 이 줄을 추가해주세요!
import { type CollectionEntry, getCollection } from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'
import { render } from 'astro:content'
import Comments from '../../components/widgets/Comments.astro'
const { slug } = Astro.params

export async function getStaticPaths() {
  const posts = await getCollection('bodong')
  return posts
    .filter((post) => !post.id.startsWith('_'))
    .map((post) => ({
      params: { slug: post.id },
      props: post
    }))
}

type Props = CollectionEntry<'bodong'>

const post = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []
const contentFeatures = remarkPluginFrontmatter.contentFeatures || {}
---

<PostLayout {...post.data} readingTime={readingTime} toc={toc} contentFeatures={contentFeatures} backHref="/bodong/">
  <Content />
  <Comments post_slug={`bodong-${slug}`} />
</PostLayout>
